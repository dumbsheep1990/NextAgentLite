# 前端环境配置文件示例
# 复制此文件为 .env.local 并根据实际环境修改配置

# ============================================
# API 基础配置
# ============================================
# 后端API地址（本地开发使用 http://localhost:8000）
VITE_API_BASE_URL=http://localhost:8000

# WebSocket 地址
VITE_WS_URL=ws://localhost:8000

# SSE（Server-Sent Events）地址
VITE_SSE_URL=http://localhost:8000

# ============================================
# 知识图谱配置（通过API网关代理）
# ============================================
VITE_MATGRAPH_BASE_URL=http://localhost:8000/api-gateway/matgraph
VITE_MATGRAPH_HOST=localhost
VITE_MATGRAPH_PORT=8000

# ============================================
# 应用基本信息
# ============================================
VITE_APP_NAME=NextAgentLite 智能问答系统
VITE_APP_VERSION=1.2.2
VITE_APP_DESCRIPTION=基于大模型的多智能体协作问答平台
VITE_APP_AUTHOR=GAC Team

# ============================================
# WebSocket 和 SSE 配置
# ============================================
VITE_SSE_RECONNECT_INTERVAL=3000
VITE_SSE_MAX_RECONNECT_ATTEMPTS=10

# ============================================
# 开发配置
# ============================================
VITE_DEV_PORT=3000
VITE_DEV_HOST=localhost
VITE_DEV_OPEN=true

# ============================================
# 调试配置
# ============================================
VITE_ENABLE_DEBUG=true
VITE_LOG_LEVEL=info
VITE_PERFORMANCE_MONITORING=true

# ============================================
# 功能开关
# ============================================
VITE_ENABLE_TRANSLATION=true
VITE_ENABLE_GRAPH_VIEW=true
VITE_ENABLE_DUAL_VECTOR=false
VITE_ENABLE_VOICE_INPUT=false
VITE_ENABLE_EXPORT=true

# ============================================
# 向量模型配置
# ============================================
VITE_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-4B
VITE_EMBEDDING_API_ENDPOINT=http://localhost:8000/v1
VITE_EMBEDDING_API_KEY=

# ============================================
# 文件上传配置
# ============================================
VITE_MAX_FILE_SIZE=52428800
VITE_ALLOWED_FILE_TYPES=.pdf,.docx,.txt,.md,.xlsx,.xls
VITE_UPLOAD_TIMEOUT=300000

# ============================================
# UI 配置
# ============================================
VITE_DEFAULT_THEME=light
VITE_ENABLE_DARK_MODE=true
VITE_PRIMARY_COLOR=#1890ff
VITE_ANTD_LOCALE=zh_CN

# ============================================
# Go微服务配置（通过API网关代理）
# ============================================
# Unla 模型工具嵌入地址
VITE_UNLA_WEB_URL=http://localhost:8000/api-gateway/model

# LLM统一配置网关
VITE_LLM_GATEWAY_URL=http://localhost:8000/api-gateway/llm-gateway

# ============================================
# 生产环境配置说明
# ============================================
# 生产环境部署时，将所有 localhost:8000 替换为实际的服务器地址
# 例如：http://your-domain.com 或 http://your-server-ip:8000
