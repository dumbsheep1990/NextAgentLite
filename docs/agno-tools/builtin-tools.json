        "allow_sudo": {
          "type": "boolean",
          "title": "允许sudo",
          "description": "是否允许使用sudo命令",
          "default": false
        }
      },
      "required": []
    }
  },
  {
    "tool_code": "builtin:read_file",
    "tool_name": "读取文件",
    "tool_type": "builtin",
    "description": "读取指定路径的文件内容",
    "config_schema": {
      "type": "object",
      "properties": {
        "max_file_size": {
          "type": "integer",
          "title": "最大文件大小（MB）",
          "description": "允许读取的最大文件大小",
          "default": 10,
          "minimum": 1,
          "maximum": 100
        },
        "allowed_extensions": {
          "type": "string",
          "title": "允许的文件扩展名",
          "description": "允许读取的文件扩展名（逗号分隔）",
          "default": "txt,md,json,yaml,yml,xml,csv"
        },
        "encoding": {
          "type": "string",
          "title": "文件编码",
          "description": "读取文件时使用的编码",
          "enum": ["utf-8", "gbk", "gb2312", "ascii"],
          "default": "utf-8"
        }
      },
      "required": []
    }
  },
  {
    "tool_code": "builtin:write_file",
    "tool_name": "写入文件",
    "tool_type": "builtin",
    "description": "将内容写入指定路径的文件",
    "config_schema": {
      "type": "object",
      "properties": {
        "max_file_size": {
          "type": "integer",
          "title": "最大文件大小（MB）",
          "description": "允许写入的最大文件大小",
          "default": 10,
          "minimum": 1,
          "maximum": 100
        },
        "allowed_directories": {
          "type": "string",
          "title": "允许的目录",
          "description": "允许写入的目录路径（逗号分隔）",
          "default": "/tmp"
        },
        "encoding": {
          "type": "string",
          "title": "文件编码",
          "description": "写入文件时使用的编码",
          "enum": ["utf-8", "gbk", "gb2312", "ascii"],
          "default": "utf-8"
        },
        "overwrite": {
          "type": "boolean",
          "title": "允许覆盖",
          "description": "是否允许覆盖已存在的文件",
          "default": false
        }
      },
      "required": []
    }
  },
  {
    "tool_code": "builtin:calculator",
    "tool_name": "计算器",
    "tool_type": "builtin",
    "description": "执行数学计算",
    "config_schema": {
      "type": "object",
      "properties": {
        "precision": {
          "type": "integer",
          "title": "精度",
          "description": "计算结果的小数位数",
          "default": 10,
          "minimum": 0,
          "maximum": 20
        },
        "angle_mode": {
          "type": "string",
          "title": "角度模式",
          "description": "三角函数使用的角度模式",
          "enum": ["degrees", "radians"],
          "default": "radians"
        }
      },
      "required": []
    }
