[
  {
    "tool_code": "builtin:reasoning",
    "tool_name": "推理(思考)",
    "tool_type": "builtin",
    "description": "显式思考与分解步骤，在回答前进行深度推理",
    "config_schema": {
      "type": "object",
      "properties": {
        "show_thinking": {
          "type": "boolean",
          "title": "显示思考过程",
          "description": "是否在最终回答中显示推理过程",
          "default": false
        },
        "max_thinking_tokens": {
          "type": "integer",
          "title": "最大思考Tokens",
          "description": "推理过程的最大token数量",
          "default": 2000,
          "minimum": 500,
          "maximum": 8000
        },
        "thinking_budget": {
          "type": "integer",
          "title": "思考预算",
          "description": "允许的最大推理步骤数",
          "default": 10,
          "minimum": 1,
          "maximum": 50
        }
      },
      "required": []
    }
  },
  {
    "tool_code": "builtin:duckduckgo",
    "tool_name": "DuckDuckGo 搜索",
    "tool_type": "builtin",
    "description": "使用DuckDuckGo进行网页搜索",
    "config_schema": {
      "type": "object",
      "properties": {
        "max_results": {
          "type": "integer",
          "title": "最大结果数",
          "description": "返回的最大搜索结果数量",
          "default": 10,
          "minimum": 1,
          "maximum": 50
        },
        "region": {
          "type": "string",
          "title": "地区设置",
          "description": "搜索结果的地区偏好",
          "enum": ["wt-wt", "us-en", "uk-en", "ru-ru", "cn-zh"],
          "default": "wt-wt"
        },
        "safe_search": {
          "type": "string",
          "title": "安全搜索",
          "description": "安全搜索级别",
          "enum": ["on", "moderate", "off"],
          "default": "moderate"
        },
        "time_range": {
          "type": "string",
          "title": "时间范围",
          "description": "搜索结果的时间范围",
          "enum": ["d", "w", "m", "y", ""],
          "default": ""
        }
      },
      "required": []
    }
  },
  {
    "tool_code": "builtin:arxiv",
    "tool_name": "arXiv 学术搜索",
    "tool_type": "builtin",
    "description": "搜索arXiv学术论文数据库",
    "config_schema": {
      "type": "object",
      "properties": {
        "max_results": {
          "type": "integer",
          "title": "最大结果数",
          "description": "返回的最大论文数量",
          "default": 5,
          "minimum": 1,
          "maximum": 20
        },
        "sort_by": {
          "type": "string",
          "title": "排序方式",
          "description": "搜索结果排序方式",
          "enum": ["relevance", "lastUpdatedDate", "submittedDate"],
          "default": "relevance"
        },
        "sort_order": {
          "type": "string",
          "title": "排序顺序",
          "description": "升序或降序",
          "enum": ["ascending", "descending"],
          "default": "descending"
        }
      },
      "required": []
    }
  },
  {
    "tool_code": "builtin:python",
    "tool_name": "Python 代码执行",
    "tool_type": "builtin",
    "description": "在沙盒环境中执行Python代码",
    "config_schema": {
      "type": "object",
      "properties": {
        "timeout": {
          "type": "integer",
          "title": "执行超时（秒）",
          "description": "代码执行的最大时间限制",
          "default": 30,
          "minimum": 5,
          "maximum": 300
        },
        "allowed_imports": {
          "type": "string",
          "title": "允许的导入模块",
          "description": "允许导入的Python模块列表（逗号分隔）",
          "default": "math,datetime,json,re"
        },
        "max_output_length": {
          "type": "integer",
          "title": "最大输出长度",
          "description": "代码输出的最大字符数",
          "default": 10000,
          "minimum": 1000,
          "maximum": 100000
        }
      },
      "required": []
    }
  },
  {
    "tool_code": "builtin:shell",
    "tool_name": "Shell 命令执行",
    "tool_type": "builtin",
    "description": "在系统中执行Shell命令",
    "config_schema": {
      "type": "object",
      "properties": {
        "timeout": {
          "type": "integer",
          "title": "执行超时（秒）",
          "description": "命令执行的最大时间限制",
          "default": 60,
          "minimum": 5,
          "maximum": 300
        },
        "working_directory": {
          "type": "string",
          "title": "工作目录",
          "description": "命令执行的工作目录",
          "default": "/tmp"
