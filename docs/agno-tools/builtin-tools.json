  {
    "tool_code": "builtin:baidu",
    "tool_name": "百度搜索",
    "tool_type": "builtin",
    "description": "使用百度搜索引擎进行中英文搜索，支持结果过滤和智能重排",
    "config_schema": {
      "type": "object",
      "properties": {
        "max_results": {
          "type": "integer",
          "title": "最大结果数",
          "description": "返回的最大搜索结果数量",
          "default": 5,
          "minimum": 1,
          "maximum": 10
        },
        "language": {
          "type": "string",
          "title": "搜索语言",
          "description": "搜索语言: zh=中文, en=英文",
          "enum": ["zh", "en"],
          "default": "zh"
        },
        "timeout": {
          "type": "integer",
          "title": "超时时间（秒）",
          "description": "搜索请求的超时时间",
          "default": 10,
          "minimum": 5,
          "maximum": 60
        },
        "enable_filter": {
          "type": "boolean",
          "title": "启用结果过滤",
          "description": "过滤低质量、广告和重复结果",
          "default": true
        },
        "enable_rerank": {
          "type": "boolean",
          "title": "启用智能重排",
          "description": "根据相关性对搜索结果重新排序",
          "default": true
        },
        "proxy": {
          "type": "string",
          "title": "代理服务器",
          "description": "代理服务器地址（可选，格式: http://proxy:port）",
          "default": ""
        }
      },
      "required": []
    }
  }
]
