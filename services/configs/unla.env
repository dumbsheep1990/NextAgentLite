###############################################
# Unla local .env (SQLite, non-Docker)
# This file will be auto-loaded by scripts/unla_env.sh
###############################################

# --- Logging (defaults are fine for local) ---
APISERVER_LOGGER_LEVEL=info
APISERVER_LOGGER_FORMAT=console
APISERVER_LOGGER_OUTPUT=stdout
LOGGER_LEVEL=info
LOGGER_FORMAT=console
LOGGER_OUTPUT=stdout

# --- Admin & Auth ---
SUPER_ADMIN_USERNAME=admin
SUPER_ADMIN_PASSWORD=admin
APISERVER_JWT_SECRET_KEY=local-dev-key
APISERVER_JWT_DURATION=24h

# --- API Server DB (PostgreSQL, from backend .env.local DATABASE_URL) ---
APISERVER_DB_TYPE=postgres
APISERVER_DB_HOST=localhost
APISERVER_DB_PORT=5434
APISERVER_DB_USER=zzdsj_demo
APISERVER_DB_PASSWORD=zzdsj123!
APISERVER_DB_NAME=zzdsj_demo
APISERVER_DB_SSL_MODE=disable

# --- Gateway Storage DB (PostgreSQL) ---
GATEWAY_STORAGE_TYPE=db
GATEWAY_DB_TYPE=postgres
GATEWAY_DB_HOST=localhost
GATEWAY_DB_PORT=5434
GATEWAY_DB_USER=zzdsj_demo
GATEWAY_DB_PASSWORD=zzdsj123!
GATEWAY_DB_NAME=zzdsj_demo
GATEWAY_DB_SSL_MODE=disable

# --- Session ---
SESSION_STORAGE_TYPE=memory

# --- MCP Gateway ports and PID ---
MCP_GATEWAY_PORT=5235
MCP_GATEWAY_PID=/Users/wxn/Desktop/NextAgentLite/logs/mcp-gateway.pid
APISERVER_NOTIFIER_SIGNAL_PID=/Users/wxn/Desktop/NextAgentLite/logs/mcp-gateway.pid
NOTIFIER_SIGNAL_PID=/Users/wxn/Desktop/NextAgentLite/logs/mcp-gateway.pid
MCP_GATEWAY_RELOAD_INTERVAL=600s
MCP_GATEWAY_RELOAD_SWITCH=true

# --- Web runtime config ---
# 若通过后端反代访问，设为 http://localhost:8000/gateway
# 直接访问网关端口时设为 http://localhost:5235
VITE_API_BASE_URL=/api
VITE_WS_BASE_URL=/api/ws
VITE_MCP_GATEWAY_BASE_URL=http://localhost:5235
VITE_DIRECT_MCP_GATEWAY_MODIFIER=:5235
VITE_BASE_URL=/
DEBUG_MODE=false
ENABLE_EXPERIMENTAL=false
LLM_CONFIG_ADMIN_ONLY=false

# --- DB Table prefix to avoid conflicts with backend tables ---
UNLA_DB_TABLE_PREFIX=unla_

# --- i18n & misc ---
APISERVER_I18N_PATH=/Users/wxn/Desktop/NextAgentLite/services/configs/unla-configs/i18n
TZ=UTC
