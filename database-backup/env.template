# NextAgentLite 环境配置模板
# 复制此文件为 .env 并根据实际环境修改配置值

#################################################
# 应用基础配置
#################################################
APP_NAME="NextAgentLite"
APP_ENV="production"  # development / production
DEBUG="false"
LOG_LEVEL="INFO"  # DEBUG / INFO / WARNING / ERROR

#################################################
# PostgreSQL 数据库配置
#################################################
DATABASE_URL="postgresql://user:password@localhost:5432/nextagent_lite"

# 分离配置（可选）
DB_HOST="localhost"
DB_PORT="5432"
DB_NAME="nextagent_lite"
DB_USER="user"
DB_PASSWORD="password"

# 连接池配置
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30

#################################################
# Elasticsearch 配置
#################################################
ELASTICSEARCH_URL="http://localhost:9200"
ELASTICSEARCH_USERNAME="elastic"
ELASTICSEARCH_PASSWORD="your_password"
ELASTICSEARCH_VERIFY_CERTS="false"
ELASTICSEARCH_REQUEST_TIMEOUT=30
ELASTICSEARCH_MAX_RETRIES=3

# 索引名称配置
ES_INDEX_CHUNKS="mat_qa_chunks"
ES_INDEX_PAPERS="mat_qa_papers"
ES_INDEX_DOCUMENTS="mat_qa_documents"
ES_INDEX_MEDIA="mat_qa_media"
ES_INDEX_CACHE="mat_qa_retrieval_cache"
ES_INDEX_GENERAL_VECTORS="mat_qa_general_vectors"
ES_INDEX_DOMAIN_VECTORS="mat_qa_domain_vectors"

#################################################
# Redis 配置
#################################################
REDIS_URL="redis://localhost:6379/0"

# 分离配置（可选）
REDIS_HOST="localhost"
REDIS_PORT="6379"
REDIS_PASSWORD=""
REDIS_DB=0

# 连接池配置
REDIS_MAX_CONNECTIONS=20
REDIS_TIMEOUT=10
REDIS_HEALTH_CHECK_INTERVAL=30

#################################################
# MinIO 对象存储配置
#################################################
MINIO_ENABLED="true"
MINIO_ENDPOINT="localhost:9000"
MINIO_ACCESS_KEY="minio"
MINIO_SECRET_KEY="minio123"
MINIO_SECURE="false"  # true for HTTPS
MINIO_REGION="us-east-1"

# 公共访问配置
MINIO_PUBLIC_ENDPOINT="http://localhost:9000"
MINIO_PRESIGNED_URL_EXPIRES="3600"  # 秒
MINIO_AUTO_CREATE_BUCKETS="true"
MINIO_SKIP_BUCKET_VALIDATION="true"

# 存储桶配置
MINIO_DOCUMENTS_BUCKET="policy-qa-documents"
MINIO_MEDIA_BUCKET="policy-qa-media"
MINIO_THUMBNAILS_BUCKET="policy-qa-thumbnails"
MINIO_KNOWLEDGE_GRAPH_BUCKET="policy-qa-knowledge-graph"
MINIO_REPORTS_BUCKET="policy-qa-reports"
MINIO_BACKUPS_BUCKET="policy-qa-backups"
MINIO_LOGS_BUCKET="policy-qa-logs"
MINIO_CACHE_BUCKET="policy-qa-cache"

#################################################
# LLM 模型配置
#################################################
# 默认LLM模型
DEFAULT_LLM_MODEL="qwen3-30b-a3b-instruct-2507"
DEFAULT_LLM_PROVIDER="alibaba"  # alibaba / google / openai

# 阿里云模型配置
ALIBABA_LLM_API_KEY="your_api_key"
ALIBABA_LLM_BASE_URL="https://dashscope.aliyuncs.com/compatible-mode/v1"
ALIBABA_LLM_TIMEOUT=120

# Google Gemini配置（可选）
GOOGLE_API_KEY="your_google_api_key"
GOOGLE_LLM_MODEL="gemini-1.5-pro"

# OpenAI配置（可选）
OPENAI_API_KEY="your_openai_api_key"
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_MODEL="gpt-4"

#################################################
# 嵌入模型配置
#################################################
# 通用向量模型
GENERAL_EMBEDDING_MODEL="text-embedding-v4"
GENERAL_EMBEDDING_DIMENSION=1024
GENERAL_EMBEDDING_API_KEY="your_embedding_api_key"

# 领域向量模型（MatBERT）
DOMAIN_EMBEDDING_MODEL="matbert"
DOMAIN_EMBEDDING_DIMENSION=768
DOMAIN_EMBEDDING_ENABLED="true"

# 双向量检索配置
DUAL_VECTOR_ENABLED="true"
GENERAL_VECTOR_WEIGHT=0.6
DOMAIN_VECTOR_WEIGHT=0.4

#################################################
# DataGraph 知识图谱配置
#################################################
MATGRAPH_SERVICE_URL="http://localhost:9622"
MATGRAPH_QUERY_MODE="mix"  # local / global / mix
MATGRAPH_ENABLED="true"
MATGRAPH_TIMEOUT=30

#################################################
# Agent 配置
#################################################
# Agent配置文件路径
AGENT_CONFIG_PATH="config/agent_teams_v2.yaml"

# 默认Agent配置
DEFAULT_AGENT_TEMPERATURE=0.7
DEFAULT_AGENT_MAX_TOKENS=2000
DEFAULT_AGENT_TIMEOUT=120

# Team配置
TEAM_EXECUTION_TIMEOUT=300
TEAM_MAX_RETRIES=3
TEAM_ENABLE_MEMORY="true"

#################################################
# 检索配置
#################################################
# 默认检索参数
DEFAULT_TOP_K=10
DEFAULT_THRESHOLD=0.7
DEFAULT_ENABLE_RERANK="true"
DEFAULT_ENABLE_TRANSLATION="true"

# 检索策略
RETRIEVAL_STRATEGY="hybrid"  # vector / keyword / hybrid / graph_enhanced

#################################################
# 翻译配置
#################################################
TRANSLATION_ENABLED="true"
TRANSLATION_PROVIDER="alibaba"  # alibaba / google
TRANSLATION_CACHE_TTL=86400  # 24小时
TRANSLATION_MAX_LENGTH=5000

#################################################
# 文档处理配置
#################################################
# 分块配置
DEFAULT_CHUNK_SIZE=800
DEFAULT_CHUNK_OVERLAP=200
MAX_CHUNK_SIZE=2000
MIN_CHUNK_SIZE=100

# 文件上传配置
MAX_UPLOAD_SIZE=52428800  # 50MB
ALLOWED_EXTENSIONS="pdf,docx,txt,md,doc,pptx,xlsx"

# OCR配置
OCR_ENABLED="true"
OCR_PROVIDER="paddleocr"  # paddleocr / tesseract

#################################################
# 任务队列配置
#################################################
TASK_QUEUE_ENABLED="true"
TASK_WORKER_COUNT=4
TASK_MAX_RETRIES=3
TASK_RETRY_DELAY=5  # 秒
TASK_TIMEOUT=600  # 秒

# 队列优先级
QUEUE_HIGH_PRIORITY="queue:high_priority"
QUEUE_NORMAL_PRIORITY="queue:normal_priority"
QUEUE_LOW_PRIORITY="queue:low_priority"

#################################################
# 缓存配置
#################################################
# LLM缓存
LLM_CACHE_ENABLED="true"
LLM_CACHE_TTL=3600  # 1小时

# 检索缓存
RETRIEVAL_CACHE_ENABLED="true"
RETRIEVAL_CACHE_TTL=1800  # 30分钟

# 配置缓存
CONFIG_CACHE_TTL=21600  # 6小时

#################################################
# API 配置
#################################################
API_HOST="0.0.0.0"
API_PORT=8000
API_WORKERS=4
API_RELOAD="false"  # 仅在开发环境使用

# CORS配置
CORS_ORIGINS="http://localhost:5173,http://localhost:3000"
CORS_ALLOW_CREDENTIALS="true"

# API限流
RATE_LIMIT_ENABLED="true"
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD=60  # 秒

#################################################
# 前端配置（用于前端.env.local）
#################################################
VITE_API_BASE_URL="http://localhost:8000"
VITE_MATGRAPH_BASE_URL="http://localhost:9622"
VITE_MINIO_PUBLIC_URL="http://localhost:9000"

# 功能开关
VITE_ENABLE_GRAPH_VIEW="true"
VITE_ENABLE_DUAL_VECTOR="true"
VITE_ENABLE_TRANSLATION="true"
VITE_ENABLE_TEAM_MODE="true"
VITE_ENABLE_OCR="true"

#################################################
# 监控和日志配置
#################################################
# 日志配置
LOG_FILE_PATH="logs/app.log"
LOG_FILE_MAX_SIZE=10485760  # 10MB
LOG_FILE_BACKUP_COUNT=10
LOG_FORMAT="%(asctime)s - %(name)s - %(levelname)s - %(message)s"

# 性能监控
PERFORMANCE_MONITORING="true"
SLOW_QUERY_THRESHOLD=1.0  # 秒

# 健康检查
HEALTH_CHECK_ENABLED="true"
HEALTH_CHECK_INTERVAL=30  # 秒

#################################################
# 安全配置
#################################################
# JWT配置（如果使用认证）
SECRET_KEY="your_secret_key_change_in_production"
JWT_ALGORITHM="HS256"
JWT_EXPIRATION=86400  # 24小时

# 加密配置
ENCRYPTION_ENABLED="false"
ENCRYPTION_KEY=""

#################################################
# 其他配置
#################################################
# 时区
TIMEZONE="Asia/Shanghai"

# 多语言支持
DEFAULT_LANGUAGE="zh-CN"
SUPPORTED_LANGUAGES="zh-CN,en-US"

# 系统维护
MAINTENANCE_MODE="false"
MAINTENANCE_MESSAGE="系统维护中，请稍后访问"
