{
  "elasticsearch_index_design": {
    "version": "2.0.0",
    "description": "NextAgent Lite ES索引设计模板 - 简化版（移除双向量和mat前缀）",
    "created_at": "2025-09-11",
    "updated_by": "Claude",
    "changes": [
      "移除双向量支持（general_embedding和domain_embedding）",
      "使用单一embedding字段",
      "移除所有mat_qa前缀",
      "更新向量维度为2560（Qwen3-Embedding-4B实际输出）"
    ],
    "connection_settings": {
      "hosts": ["http://localhost:9200"],
      "request_timeout": 30,
      "max_retries": 3,
      "retry_on_timeout": true,
      "verify_certs": false,
      "ssl_show_warn": false
    },
    "index_templates": {
      "document_chunks": {
        "description": "文档分块索引，支持向量检索",
        "index_patterns": ["document_chunks*"],
        "version": 2,
        "template": {
          "settings": {
            "number_of_shards": 1,
            "number_of_replicas": 0,
            "max_result_window": 50000,
            "analysis": {
              "analyzer": {
                "chinese_analyzer": {
                  "type": "custom",
                  "tokenizer": "standard",
                  "filter": ["lowercase", "stop", "chinese_stop"]
                },
                "english_analyzer": {
                  "type": "custom",
                  "tokenizer": "standard",
                  "filter": ["lowercase", "stop", "stemmer"]
                },
                "mixed_analyzer": {
                  "type": "custom",
                  "tokenizer": "standard",
                  "filter": ["lowercase", "icu_folding", "cjk_width"]
                }
              },
              "filter": {
                "chinese_stop": {
                  "type": "stop",
                  "stopwords": ["的", "是", "在", "有", "和", "与", "或", "等", "及"]
                }
              }
            }
          },
          "mappings": {
            "properties": {
              "id": {
                "type": "keyword"
              },
              "document_id": {
                "type": "keyword",
                "index": true
              },
              "chunk_index": {
                "type": "integer",
                "index": true
              },
              "content": {
                "type": "text",
                "analyzer": "mixed_analyzer",
                "search_analyzer": "mixed_analyzer",
                "fields": {
                  "chinese": {
                    "type": "text",
                    "analyzer": "chinese_analyzer"
                  },
                  "english": {
                    "type": "text",
                    "analyzer": "english_analyzer"
                  },
                  "keyword": {
                    "type": "keyword",
                    "ignore_above": 512
                  }
                }
              },
              "title": {
                "type": "text",
                "analyzer": "mixed_analyzer",
                "fields": {
                  "keyword": {
                    "type": "keyword",
                    "ignore_above": 256
                  },
                  "suggest": {
                    "type": "completion",
                    "max_input_length": 50
                  }
                }
              },
              "embedding": {
                "type": "dense_vector",
                "dims": 2560,
                "index": true,
                "similarity": "cosine"
              },
              "embedding_model": {
                "type": "keyword",
                "index": true
              },
              "document_type": {
                "type": "keyword",
                "index": true
              },
              "tags": {
                "type": "keyword",
                "index": true
              },
              "metadata": {
                "type": "object",
                "dynamic": true,
                "properties": {
                  "confidence": {
                    "type": "float"
                  },
                  "language": {
                    "type": "keyword"
                  },
                  "section": {
                    "type": "text",
                    "analyzer": "mixed_analyzer"
                  },
                  "page": {
                    "type": "integer"
                  }
                }
              },
              "source_info": {
                "type": "object",
                "properties": {
                  "filename": {
                    "type": "keyword",
                    "index": true
                  },
                  "file_type": {
                    "type": "keyword",
                    "index": true
                  },
                  "page": {
                    "type": "integer"
                  },
                  "section": {
                    "type": "text",
                    "analyzer": "mixed_analyzer"
                  }
                }
              },
              "created_at": {
                "type": "date",
                "format": "strict_date_optional_time||epoch_millis"
              },
              "updated_at": {
                "type": "date",
                "format": "strict_date_optional_time||epoch_millis"
              }
            }
          }
        }
      },
      "general_vectors": {
        "description": "通用向量索引（独立存储）",
