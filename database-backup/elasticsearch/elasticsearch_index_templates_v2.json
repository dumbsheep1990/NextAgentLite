      }
    },
    "aliases": {
      "chunks": {
        "index": "document_chunks",
        "description": "文档分块索引别名"
      },
      "cache": {
        "index": "retrieval_cache",
        "description": "检索缓存索引别名"
      }
    },
    "index_lifecycle_policies": {
      "retrieval_cache_policy": {
        "description": "检索缓存生命周期策略",
        "phases": {
          "hot": {
            "actions": {
              "rollover": {
                "max_age": "30d",
                "max_size": "50GB"
              }
            }
          },
          "delete": {
            "min_age": "90d",
            "actions": {
              "delete": {}
            }
          }
        }
      }
    },
    "migration_notes": [
      "从v1.3.2迁移到v2.0.0:",
      "1. 备份现有数据",
      "2. 删除所有mat_qa_*索引",
      "3. 使用新模板创建索引",
      "4. 重新索引数据，注意字段映射变化",
      "5. 更新应用程序代码中的索引名称和字段名称"
    ]
  }
