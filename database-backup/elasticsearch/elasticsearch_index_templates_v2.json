      "retrieval_cache": {
        "description": "检索缓存索引",
        "index_patterns": ["retrieval_cache*"],
        "version": 2,
        "template": {
          "settings": {
            "number_of_shards": 1,
            "number_of_replicas": 0,
            "max_result_window": 10000,
            "analysis": {
              "analyzer": {
                "mixed_analyzer": {
                  "type": "custom",
                  "tokenizer": "standard",
                  "filter": ["lowercase", "icu_folding", "cjk_width"]
                }
              }
            }
          },
          "mappings": {
            "properties": {
              "query_hash": {
                "type": "keyword"
              },
              "query": {
                "type": "text",
                "analyzer": "mixed_analyzer",
                "fields": {
                  "keyword": {
                    "type": "keyword",
                    "ignore_above": 512
                  }
                }
              },
              "query_embedding": {
                "type": "dense_vector",
                "dims": 2560,
                "index": true,
                "similarity": "cosine"
              },
              "retrieval_strategy": {
                "type": "keyword"
              },
              "results": {
                "type": "nested",
                "properties": {
                  "document_id": {
                    "type": "keyword"
                  },
                  "chunk_id": {
                    "type": "keyword"
                  },
                  "score": {
                    "type": "float"
                  },
                  "content": {
                    "type": "text"
                  }
                }
              },
              "metadata": {
                "type": "object",
                "dynamic": true,
                "properties": {
                  "user_id": {
                    "type": "keyword"
                  },
                  "session_id": {
                    "type": "keyword"
                  },
                  "model_used": {
                    "type": "keyword"
                  },
                  "response_time_ms": {
                    "type": "integer"
                  }
                }
              },
              "hit_count": {
                "type": "integer"
              },
              "created_at": {
                "type": "date"
              },
              "last_accessed_at": {
                "type": "date"
              },
              "ttl": {
                "type": "long"
              }
            }
          }
        }
