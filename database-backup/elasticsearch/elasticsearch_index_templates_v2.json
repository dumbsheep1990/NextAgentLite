                  "filter": ["lowercase", "icu_folding", "cjk_width"]
                }
              }
            }
          },
          "mappings": {
            "properties": {
              "id": {
                "type": "keyword"
              },
              "title": {
                "type": "text",
                "analyzer": "mixed_analyzer",
                "fields": {
                  "keyword": {
                    "type": "keyword"
                  }
                }
              },
              "authors": {
                "type": "text",
                "analyzer": "mixed_analyzer",
                "fields": {
                  "keyword": {
                    "type": "keyword"
                  }
                }
              },
              "abstract": {
                "type": "text",
                "analyzer": "mixed_analyzer"
              },
              "abstract_embedding": {
                "type": "dense_vector",
                "dims": 2560,
                "index": true,
                "similarity": "cosine"
              },
              "journal": {
                "type": "text",
                "analyzer": "mixed_analyzer",
                "fields": {
                  "keyword": {
                    "type": "keyword"
                  }
                }
              },
              "year": {
                "type": "integer"
              },
              "doi": {
                "type": "keyword"
              },
              "keywords": {
                "type": "keyword"
              },
              "paper_type": {
                "type": "keyword"
              },
              "tags": {
                "type": "keyword"
              },
              "metadata": {
                "type": "object",
                "dynamic": true
              },
              "created_at": {
                "type": "date"
              },
