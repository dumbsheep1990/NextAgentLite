                "analyzer": "mixed_analyzer",
                "fields": {
                  "keyword": {
                    "type": "keyword"
                  }
                }
              },
              "filename": {
                "type": "keyword"
              },
              "file_type": {
                "type": "keyword"
              },
              "file_size": {
                "type": "long"
              },
              "description": {
                "type": "text",
                "analyzer": "mixed_analyzer"
              },
              "tags": {
                "type": "keyword"
              },
              "source": {
