                "type": "keyword"
              },
              "tags": {
                "type": "keyword"
              },
              "metadata": {
                "type": "object",
                "dynamic": true
              },
              "source_info": {
                "type": "object",
                "properties": {
                  "filename": {
                    "type": "keyword"
                  },
                  "file_type": {
                    "type": "keyword"
                  },
                  "page": {
                    "type": "integer"
                  },
                  "section": {
                    "type": "text"
                  }
                }
              },
              "created_at": {
                "type": "date"
              },
              "updated_at": {
                "type": "date"
              }
            }
          }
        }
      },
      "papers": {
