# ============================================================================
# MinIO 对象存储配置
# ============================================================================
# 是否启用MinIO存储（true/false）
MINIO_ENABLED="true"

# MinIO 服务端点
MINIO_ENDPOINT="localhost:9000"

# MinIO 访问密钥
MINIO_ACCESS_KEY="admin"

# MinIO 秘密密钥
MINIO_SECRET_KEY="wxn199002"

# 是否使用HTTPS（true/false）
MINIO_SECURE="false"

# 存储区域
# MINIO_REGION=us-east-1

# 文档存储桶名称
MINIO_DOCUMENTS_BUCKET="mat-qa-documents"

# 媒体文件存储桶名称
MINIO_MEDIA_BUCKET="mat-qa-media"

# 缩略图存储桶名称
MINIO_THUMBNAILS_BUCKET="mat-qa-thumbnails"

# 公共访问端点
MINIO_PUBLIC_ENDPOINT="http://localhost:9000"

# CDN端点（可选）
# MINIO_CDN_ENDPOINT="https://cdn.example.com"

# 预签名URL过期时间（秒）
MINIO_PRESIGNED_URL_EXPIRES="3600"

# 是否自动创建存储桶（true/false）
MINIO_AUTO_CREATE_BUCKETS="true"

# ============================================================================
# 可选配置
# ============================================================================
# 日志级别: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL="INFO"

# API服务监听端口
API_PORT="8000"

# API服务监听地址
API_HOST="0.0.0.0"

# 跨域请求允许的域名列表（逗号分隔）
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# 上传文件大小限制（MB）
MAX_UPLOAD_SIZE="50"

# 向量化处理批次大小
VECTORIZATION_BATCH_SIZE="100" 