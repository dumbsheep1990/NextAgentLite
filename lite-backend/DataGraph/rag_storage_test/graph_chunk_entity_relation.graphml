  <data key="d5">1754208127</data>
</node>
<node id="ZnO">
  <data key="d0">ZnO</data>
  <data key="d1">category</data>
  <data key="d2">ZnO (zinc oxide) is present as small white particles in gum natural rubber vulcanizates, visible in microscopy images.&lt;SEP&gt;ZnO is used in the formulation of NR/geopolymer composites with a quantity of 5 phr and mixing time of 2 minutes.</data>
  <data key="d3">chunk-b59a215607da3067fe396c2706185342&lt;SEP&gt;chunk-c9f812eeaa3c93f5c4d945e0ae7c91d0</data>
  <data key="d4">doi_10.1002_adv.21940.md</data>
  <data key="d5">1754208129</data>
</node>
<node id="Stearic acid">
  <data key="d0">Stearic acid</data>
  <data key="d1">category</data>
  <data key="d2">Stearic acid is an ingredient in the NR/geopolymer composite formulation, used at 1 phr with a mixing time of 1 minute.</data>
  <data key="d3">chunk-c9f812eeaa3c93f5c4d945e0ae7c91d0</data>
  <data key="d4">doi_10.1002_adv.21940.md</data>
  <data key="d5">1754208129</data>
</node>
<node id="MBTs">
  <data key="d0">MBTs</data>
  <data key="d1">category</data>
  <data key="d2">MBTs is a chemical additive used in the composite formulation at 0.5 phr with a mixing time of 1 minute.</data>
  <data key="d3">chunk-c9f812eeaa3c93f5c4d945e0ae7c91d0</data>
  <data key="d4">doi_10.1002_adv.21940.md</data>
  <data key="d5">1754208129</data>
</node>
<node id="Fourier-transform infrared spectroscopy (FTIR)">
  <data key="d0">Fourier-transform infrared spectroscopy (FTIR)</data>
  <data key="d1">organization</data>
  <data key="d2">Fourier-transform infrared spectroscopy (FTIR) is an analytical technique used with a Vertex70 instrument from Bruker to characterize functional groups in geopolymer particles.</data>
  <data key="d3">chunk-c9f812eeaa3c93f5c4d945e0ae7c91d0</data>
  <data key="d4">doi_10.1002_adv.21940.md</data>
  <data key="d5">1754208130</data>
