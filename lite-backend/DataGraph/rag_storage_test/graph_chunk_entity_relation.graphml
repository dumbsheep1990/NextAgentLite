</edge>
<edge source="Geopolymer" target="NaOH Solution">
  <data key="d6">10.0</data>
  <data key="d7">NaOH solution acts as an alkaline activator that dissolves fly ash to form geopolymer, with 12 mol/l concentration yielding optimal results.</data>
  <data key="d8">chemical activation,reaction condition</data>
