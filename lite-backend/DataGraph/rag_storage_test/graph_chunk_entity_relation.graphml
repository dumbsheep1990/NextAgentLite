<node id="GP/NR and FA/NR Composites">
  <data key="d0">GP/NR and FA/NR Composites</data>
  <data key="d1">category</data>
  <data key="d2">GP/NR and FA/NR composites are rubber-based materials filled with geopolymer or fly ash particles, subjected to vulcanization and various physical and mechanical tests.</data>
  <data key="d3">chunk-ee381638b4e2088dd8f91df9d74e6da7</data>
  <data key="d4">doi_10.1002_adv.21940.md</data>
  <data key="d5">1754208198</data>
</node>
