  <data key="d1">organization</data>
  <data key="d2">Nabon Rubber Co., Ltd. is a company based in Nakhon Si Thammarat, Thailand, that manufactures air-dried sheet natural rubber used in the study.</data>
  <data key="d3">chunk-ad60afc1fc1390582346359c09ae89a7</data>
  <data key="d4">doi_10.1002_adv.21940.md</data>
  <data key="d5">1754208101</data>
</node>
