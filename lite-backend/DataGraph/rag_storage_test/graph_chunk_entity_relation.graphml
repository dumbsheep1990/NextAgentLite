<node id="NOAA/Earth System Research Laboratory">
  <data key="d0">NOAA/Earth System Research Laboratory</data>
  <data key="d1">organization</data>
  <data key="d2">NOAA/Earth System Research Laboratory is an organization that announced the global atmospheric CO₂ concentration reached 401 ppm in May 2015.</data>
  <data key="d3">chunk-69a2fbf09309e0a17bac00036bbe5fc0</data>
