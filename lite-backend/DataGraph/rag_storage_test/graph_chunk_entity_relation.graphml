<node id="Loba Chemie Pvt.">
  <data key="d0">Loba Chemie Pvt.</data>
  <data key="d1">organization</data>
  <data key="d2">Loba Chemie Pvt. is a supplier of analytical-grade sodium hydroxide used in the geopolymerization process.</data>
  <data key="d3">chunk-ad60afc1fc1390582346359c09ae89a7</data>
