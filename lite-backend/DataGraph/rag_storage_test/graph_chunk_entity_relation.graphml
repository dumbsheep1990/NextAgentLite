  <data key="d11">1754040272</data>
</edge>
<edge source="Geopolymer" target="SEM Observation">
  <data key="d6">8.0</data>
  <data key="d7">SEM observation is used to identify unreacted fly ash particles and assess microstructural development in geopolymer-mullite composites.</data>
  <data key="d8">microstructural analysis,quality assessment</data>
