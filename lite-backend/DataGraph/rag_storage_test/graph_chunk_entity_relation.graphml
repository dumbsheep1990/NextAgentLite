<node id="NR/GP Composites">
  <data key="d0">NR/GP Composites</data>
  <data key="d1">event</data>
  <data key="d2">NR/GP composites refer to the process and resulting materials from mixing natural rubber with geopolymer, studied for their vulcanization and mechanical properties.</data>
  <data key="d3">chunk-c9f812eeaa3c93f5c4d945e0ae7c91d0</data>
  <data key="d4">doi_10.1002_adv.21940.md</data>
