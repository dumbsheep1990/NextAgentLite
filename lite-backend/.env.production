# 生产环境配置
# 地聚物材料智能问答系统后端服务

# ===== 基础配置 =====
MAT_QA_ENV=production
PYTHON_ENV=production
DEBUG=false
LOG_LEVEL=WARNING

# ===== 服务器配置 =====
HOST=0.0.0.0
PORT=8000
UVICORN_WORKERS=4

# ===== 数据库配置 =====
# 生产环境数据库连接（需要外部配置）
DATABASE_URL=postgresql://username:password@db-host:5432/mat_qa_prod
ELASTICSEARCH_HOSTS=https://es-host:9200
ARANGODB_URL=https://arangodb-host:8529
REDIS_HOST=redis-host
REDIS_PORT=6379

# ===== 存储配置 =====
MINIO_ENDPOINT=minio-host:9000
MINIO_ACCESS_KEY=prod-access-key
MINIO_SECRET_KEY=prod-secret-key
MINIO_SECURE=true

# ===== 队列配置 =====
QUEUE_MAX_CONCURRENT_TASKS=4
LARGE_FILE_MAX_CONCURRENT_TASKS=2
DOCUMENT_VECTORIZATION_CONCURRENCY=4
QA_VECTORIZATION_CONCURRENCY=2

# ===== API配置 =====
ONE_API_BASE_URL=https://api-gateway-host
ONE_API_KEY=sk-prod-api-key

# ===== 重排序模型配置 =====
ALIBABA_BAILIAN_RERANK_API_KEY=sk-8eccdd68eb4e4e26aeb482473b99dbee
ALIBABA_BAILIAN_RERANK_BASE_URL=https://dashscope.aliyuncs.com
DEFAULT_RERANK_MODEL=gte-rerank-v2
DEFAULT_RERANK_PROVIDER=alibaba_bailian
RERANK_MODELS=gte-rerank-v2

# ===== 功能开关 =====
ENABLE_GRAPH_VISUALIZATION=true
ENABLE_DUAL_VECTOR_SEARCH=true
ENABLE_MATBERT_EMBEDDING=true
ENABLE_INTELLIGENT_RETRIEVAL=true
ENABLE_TRANSLATION_SERVICE=true
ENABLE_VOICE_INPUT=false
ENABLE_EXPORT_FUNCTIONS=true

# ===== 安全配置 =====
CORS_ORIGINS=https://your-frontend-domain.com
JWT_SECRET_KEY=your-production-secret-key
API_RATE_LIMIT_REQUESTS=1000
API_RATE_LIMIT_WINDOW=60

# ===== 性能配置 =====
CACHE_TTL=3600
HTTP_TIMEOUT=60
HTTP_POOL_CONNECTIONS=20
HTTP_POOL_MAXSIZE=50

# ===== 监控配置 =====
ENABLE_METRICS=true
METRICS_PORT=8001
HEALTH_CHECK_INTERVAL=30

# ===== 开发配置 =====
RELOAD_ON_CHANGE=false
ENABLE_DEBUG_TOOLBAR=false
ENABLE_PROFILING=false