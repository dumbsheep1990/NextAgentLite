# 生产环境配置文件示例
# 复制到生产服务器并重命名为 .env

# 应用环境
MAT_QA_ENV="production"

# 安全密钥（生产环境请使用强随机密钥）
SECRET_KEY="your-production-secret-key-change-this"

# API服务配置
API_HOST="0.0.0.0"
API_PORT="8000"

# CORS跨域配置 - 根据实际前端域名调整
CORS_ORIGINS="http://8.153.90.125:3000,http://your-production-domain.com"

# 数据库配置
POSTGRESQL_HOST="8.153.90.125"
POSTGRESQL_PORT="5432"
POSTGRESQL_DATABASE="mat_demo"
POSTGRESQL_USERNAME="mat_demo"
POSTGRESQL_PASSWORD="your-production-password"

# Elasticsearch配置
ELASTICSEARCH_URL="https://8.153.90.125:9200"
ELASTICSEARCH_USERNAME="elastic"
ELASTICSEARCH_PASSWORD="your-elasticsearch-password"

# ArangoDB配置
ARANGODB_URL="http://8.153.90.125:8529"
ARANGODB_DATABASE="mat_qa_graph"
ARANGODB_USERNAME="root"
ARANGODB_PASSWORD="your-arangodb-password"

# MinIO配置
MINIO_ENABLED="true"
MINIO_ENDPOINT="8.153.90.125:9000"
MINIO_ACCESS_KEY="your-minio-access-key"
MINIO_SECRET_KEY="your-minio-secret-key"
MINIO_SECURE="false"
MINIO_AUTO_CREATE_BUCKETS="false"
MINIO_SKIP_BUCKET_VALIDATION="true"

# LLM服务配置
ONE_API_KEY="your-one-api-key"
ONE_API_BASE_URL="http://your-one-api-host:port/v1"

# MatBERT配置 - 生产环境模式
MATBERT_CONFIG_MODE="prod"
MATBERT_PROD_URL="http://122.144.131.130:60000/predict"
MATBERT_PROD_MODEL_NAME="matbert-embedding"

# MatBERT开发环境配置（备用，当config_mode=dev时使用）
# MATBERT_API_KEY="your-matbert-api-key"
# MATBERT_BASE_URL="http://your-matbert-host:8000"
# MATBERT_MODEL_NAME="matbert-embedding"

# 日志级别
LOG_LEVEL="INFO" 