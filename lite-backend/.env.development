# 开发环境配置
# 地聚物材料智能问答系统后端服务

# ===== 基础配置 =====
MAT_QA_ENV=development
PYTHON_ENV=development
DEBUG=true
LOG_LEVEL=DEBUG

# ===== 服务器配置 =====
HOST=127.0.0.1
PORT=8000
UVICORN_WORKERS=1

# ===== 数据库配置 =====
DATABASE_URL=postgresql://postgres:password@localhost:5432/mat_qa_dev
ELASTICSEARCH_HOSTS=http://localhost:9200
ARANGODB_URL=http://localhost:8529
REDIS_HOST=localhost
REDIS_PORT=6379

# ===== 存储配置 =====
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false

# ===== 队列配置 =====
QUEUE_MAX_CONCURRENT_TASKS=2
LARGE_FILE_MAX_CONCURRENT_TASKS=1
DOCUMENT_VECTORIZATION_CONCURRENCY=2
QA_VECTORIZATION_CONCURRENCY=1

# ===== API配置 =====
ONE_API_BASE_URL=http://101.132.149.115:30504
ONE_API_KEY=sk-46b0f4f88d8aa3ec1af8b60bcbf4a

# ===== 重排序模型配置 =====
ALIBABA_BAILIAN_RERANK_API_KEY=sk-8eccdd68eb4e4e26aeb482473b99dbee
ALIBABA_BAILIAN_RERANK_BASE_URL=https://dashscope.aliyuncs.com
DEFAULT_RERANK_MODEL=gte-rerank-v2
DEFAULT_RERANK_PROVIDER=alibaba_bailian
RERANK_MODELS=gte-rerank-v2

# ===== 功能开关 =====
ENABLE_GRAPH_VISUALIZATION=true
ENABLE_DUAL_VECTOR_SEARCH=true
ENABLE_MATBERT_EMBEDDING=true
ENABLE_INTELLIGENT_RETRIEVAL=true
ENABLE_TRANSLATION_SERVICE=true
ENABLE_VOICE_INPUT=true
ENABLE_EXPORT_FUNCTIONS=true

# ===== 安全配置 =====
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:4173

# ===== 性能配置 =====
CACHE_TTL=1800
HTTP_TIMEOUT=30

# ===== 监控配置 =====
ENABLE_METRICS=true
METRICS_PORT=8001

# ===== 开发配置 =====
RELOAD_ON_CHANGE=true
ENABLE_DEBUG_TOOLBAR=true
ENABLE_PROFILING=true