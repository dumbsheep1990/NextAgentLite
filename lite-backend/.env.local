# 后端本地开发环境配置
# 地聚物材料智能问答系统后端服务

# ===== 基础配置 =====
MAT_QA_ENV=development
PYTHON_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# ===== 服务器配置 =====
HOST=127.0.0.1
PORT=8000
UVICORN_WORKERS=1
UVICORN_WORKER_CONNECTIONS=1000

# ===== 数据库配置 =====
# PostgreSQL 主数据库
DATABASE_URL=postgresql://postgres:password@localhost:5432/mat_qa
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=3600

# Elasticsearch 搜索引擎
ELASTICSEARCH_HOSTS=http://localhost:9200
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=
ELASTICSEARCH_API_KEY=
ELASTICSEARCH_TIMEOUT=30
ELASTICSEARCH_MAX_RETRIES=3

# ArangoDB 图数据库
ARANGODB_URL=http://localhost:8529
ARANGODB_USERNAME=root
ARANGODB_PASSWORD=password
ARANGODB_DATABASE=mat_qa

# Redis 缓存数据库
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_TIMEOUT=10
REDIS_MAX_CONNECTIONS=20

# ===== 存储配置 =====
# MinIO 对象存储 - 使用.env中的配置

# ===== 队列配置 =====
# 任务队列配置
QUEUE_MAX_CONCURRENT_TASKS=2
LARGE_FILE_MAX_CONCURRENT_TASKS=1
LARGE_FILE_THRESHOLD=2097152
QUEUE_TASK_TIMEOUT=3600
QUEUE_MAX_RETRIES=3

# 向量化配置
DOCUMENT_VECTORIZATION_CONCURRENCY=2
QA_VECTORIZATION_CONCURRENCY=1
VECTORIZATION_BATCH_SIZE=20

# ===== API配置 =====
# One-API 统一网关（已废弃，使用LLM_GATEWAY_URL）
ONE_API_BASE_URL=http://localhost:9050/v1
ONE_API_KEY=sk-default

# QA生成模块LLM配置
GC_QA_RAG_LLM_API_BASE=http://localhost:9050/v1
GC_QA_RAG_LLM_API_KEY=
GC_QA_RAG_LLM_MODEL_NAME=Qwen/Qwen3-30B-A3B-Instruct-2507

# 支持的LLM模型
LLM_DEFAULT_MODEL=gpt-4o-mini
LLM_MODELS=gpt-4o-mini,gpt-4o,claude-3-haiku,claude-3-sonnet,claude-3-opus

# 嵌入模型
EMBEDDING_DEFAULT_MODEL=text-embedding-3-large
EMBEDDING_MODELS=text-embedding-3-large,text-embedding-3-small,text-embedding-ada-002

# ===== 功能开关 =====
# 图谱可视化
ENABLE_GRAPH_VISUALIZATION=true

# 双向量搜索
ENABLE_DUAL_VECTOR_SEARCH=true

# MatBERT专业嵌入
ENABLE_MATBERT_EMBEDDING=true

# 智能检索
ENABLE_INTELLIGENT_RETRIEVAL=true

# 翻译服务
ENABLE_TRANSLATION_SERVICE=true

# 语音输入
ENABLE_VOICE_INPUT=false

# 导出功能
ENABLE_EXPORT_FUNCTIONS=true

# ===== 安全配置 =====
# CORS 跨域配置
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# JWT 认证
JWT_SECRET_KEY=your-secret-key-here
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ===== 用户配置 =====
# 默认用户账号配置 (格式: username:password:role:displayName)
DEFAULT_USERS=admin:matscience2025:admin:系统管理员,researcher1:research123:researcher:研究员1,researcher2:research123:researcher:研究员2,researcher3:research123:researcher:研究员3

# API限流
API_RATE_LIMIT_REQUESTS=100
API_RATE_LIMIT_WINDOW=60

# ===== 性能配置 =====
# 缓存配置
CACHE_TTL=3600
CACHE_MAX_SIZE=1000

# 连接池配置
HTTP_POOL_CONNECTIONS=10
HTTP_POOL_MAXSIZE=20
HTTP_TIMEOUT=30

# ===== 监控配置 =====
# 指标监控
ENABLE_METRICS=true
METRICS_PORT=8001

# 健康检查
HEALTH_CHECK_INTERVAL=30
HEALTH_CHECK_TIMEOUT=5

# 日志配置
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s
LOG_FILE=logs/backend.log
LOG_MAX_SIZE=10485760
LOG_BACKUP_COUNT=5

# ===== 开发配置 =====
# 热重载
RELOAD_ON_CHANGE=false

# 调试模式
ENABLE_DEBUG_TOOLBAR=false

# 性能分析
ENABLE_PROFILING=false

# 测试配置
TEST_DATABASE_URL=postgresql://postgres:password@localhost:5432/mat_qa_test
TEST_ELASTICSEARCH_HOSTS=http://localhost:9201