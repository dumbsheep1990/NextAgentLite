ONE_API_KEY="sk-wboEKdPyTgltngVIDCaVU6mHuEvmGik7keR03Fws1yE3HR9m"

# One-API 服务基础URL
ONE_API_BASE_URL="http://101.132.149.115:30504/v1"

# 默认LLM模型配置
DEFAULT_LLM_MODEL="qwen-plus-latest"
DEFAULT_LLM_PROVIDER="alibaba"

# 默认嵌入模型配置
DEFAULT_EMBEDDING_MODEL="text-embedding-v4"
DEFAULT_DOMAIN_EMBEDDING_MODEL="matbert-embedding"

# 统一网关可用模型列表配置
GATEWAY_MODELS="qwen-plus-latest,gpt-4o-mini,gemini-2.5-flash-preview-thinking,gemini-2.5-flash-preview-nothinking"
# 模型映射配置
