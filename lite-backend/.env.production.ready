MATBERT_CONFIG_MODE="prod"

# 开发环境配置 (需要API KEY验证)
MATBERT_API_KEY="sk-46b0f4f88d8aa3ec1af8b60bcbf4a"
MATBERT_BASE_URL="http://198.145.104.8:8000"
MATBERT_ENDPOINT="/embed/"
MATBERT_MODEL_NAME="matbert-embedding"

# 生产环境配置 (直连模式，无需API KEY)
MATBERT_PROD_URL="http://122.144.131.130:60000/predict"
MATBERT_PROD_MODEL_NAME="matbert-embedding"

# 自定义嵌入模型配置
