MODEL_ALIASES_GPT="gpt-4o-mini"
MODEL_ALIASES_GEMINI="gemini-2.5-flash-preview-thinking,gemini-2.5-flash-preview-nothinking"
MODEL_ALIASES_EMBEDDING_ALI="text-embedding-v4"
