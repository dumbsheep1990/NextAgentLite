# ============================================================================
# Redis 缓存和队列配置
# ============================================================================
# Redis 服务器地址
REDIS_HOST="localhost"

# Redis 服务器端口
REDIS_PORT="6379"

# Redis 数据库编号 (0-15)
REDIS_DB="0"

# Redis 密码 (如果没有密码则留空)
REDIS_PASSWORD=""

# Redis 连接超时时间（秒）
REDIS_TIMEOUT="10"

# Redis 连接池最大连接数
REDIS_MAX_CONNECTIONS="20"

# ============================================================================
# MinIO 对象存储配置
# ============================================================================
# 是否启用MinIO存储（true/false）
MINIO_ENABLED="true"

# MinIO 服务端点
MINIO_ENDPOINT="8.153.90.125:9000"

# MinIO 访问密钥
MINIO_ACCESS_KEY="admin"

# MinIO 秘密密钥
MINIO_SECRET_KEY="matscience2025"

# 是否使用HTTPS（true/false）
MINIO_SECURE="false"

# 存储区域
# MINIO_REGION=us-east-1

# 文档存储桶名称
MINIO_DOCUMENTS_BUCKET="mat-qa-documents"

# 媒体文件存储桶名称
MINIO_MEDIA_BUCKET="mat-qa-media"

# 缩略图存储桶名称
MINIO_THUMBNAILS_BUCKET="mat-qa-thumbnails"

MINIO_KNOWLEDGE_GRAPH_BUCKET="mat-qa-knowledge-graph"

# 公共访问端点
MINIO_PUBLIC_ENDPOINT="http://localhost:9000"

# CDN端点（可选）
# MINIO_CDN_ENDPOINT="https://cdn.example.com"

# 预签名URL过期时间（秒）
MINIO_PRESIGNED_URL_EXPIRES="3600"

# 是否自动创建存储桶（true/false）
MINIO_AUTO_CREATE_BUCKETS="false"
MINIO_SKIP_BUCKET_VALIDATION=true


# ============================================================================
# 可选配置
# ============================================================================
# 日志级别: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL="INFO"

# API服务监听端口
API_PORT="8000"

# API服务监听地址
API_HOST="0.0.0.0"

# 跨域请求允许的域名列表（逗号分隔）
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,http://8.153.90.125:3000"

# 上传文件大小限制（MB）
MAX_UPLOAD_SIZE="50"

# ============================================================================
# 队列和并发处理配置
# ============================================================================
# 文件处理队列最大并发数
QUEUE_MAX_CONCURRENT_TASKS=2

# 文档向量化最大并发数
DOCUMENT_VECTORIZATION_CONCURRENCY=2

# QA数据集向量化最大并发数  
QA_VECTORIZATION_CONCURRENCY=1

# 向量化处理批次大小
VECTORIZATION_BATCH_SIZE=10

# 队列任务超时时间（秒）
QUEUE_TASK_TIMEOUT=3600

# 队列重试次数
QUEUE_MAX_RETRIES=3

# 大文件处理队列最大并发数（文件大小超过2MB时使用）
LARGE_FILE_MAX_CONCURRENT_TASKS=1

# 大文件阈值（字节），超过此大小的文件使用大文件队列设置（2MB）
LARGE_FILE_THRESHOLD=2097152

# ============================================================================
# 前端配置
# ============================================================================
# 前端服务地址（用于SSE连接）
FRONTEND_BASE_URL="http://localhost:3000"

# 后端API地址（前端用于连接SSE）
BACKEND_API_URL="http://localhost:8000"

# SSE连接超时时间（毫秒）
SSE_CONNECTION_TIMEOUT=30000

# 兼容旧配置
MAX_CONCURRENT_TASKS=5