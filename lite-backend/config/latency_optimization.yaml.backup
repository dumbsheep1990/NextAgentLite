# 首token延迟优化配置
# 针对用户报告的首token延迟问题的优化配置

latency_optimization:
  # 模型调用优化
  model_calling:
    # 禁用模型预热（避免启动时的无意义预热逻辑）
    enable_warmup: false
    # 预热模型列表（更新为实际可用的模型）
    warmup_models:
      - "moonshotai/Kimi-K2-Instruct"
      - "Qwen/Qwen3-235B-A22B-Thinking-2507"
    # 预热并发数
    warmup_concurrency: 2
    # 预热查询
    warmup_queries:
      - "你好"
      - "地聚物材料"
    
    # 连接池优化
    connection_pool:
      # 保持连接存活
      keep_alive: true
      # 连接池大小
      pool_size: 10
      # 最大连接数
      max_connections: 20
      # 连接超时（秒）
      connect_timeout: 5
      # 读取超时（秒）
      read_timeout: 30
      # 空闲连接保持时间（秒）
      idle_timeout: 60
    
    # 请求优化
    request_optimization:
      # 启用HTTP/2
      http2: true
      # 启用连接复用
      reuse_connections: true
      # 禁用SSL验证（仅开发环境）
      verify_ssl: false
      # 启用压缩
      compress: true
      
  # 网络层优化
  networking:
    # DNS缓存
    dns_cache:
      enabled: true
      ttl: 300  # 5分钟
    
    # TCP优化
    tcp_optimization:
      # 启用TCP快速打开
      tcp_fastopen: true
      # 启用TCP窗口缩放
      tcp_window_scaling: true
      # 禁用Nagle算法
      tcp_nodelay: true
    
    # 代理配置（如果使用）
    proxy:
      enabled: false
      timeout: 10
  
  # SSE流式优化
  streaming:
    # 流式缓冲区大小
    buffer_size: 1024
    # 流式chunk大小
    chunk_size: 512
    # 启用流式预读
    enable_prefetch: true
    # 预读缓冲区大小
    prefetch_buffer: 2048
    # 流式刷新间隔（毫秒）
    flush_interval: 10
    
    # SSE配置
    sse:
      # 心跳间隔（秒）
      heartbeat_interval: 30
      # 重连间隔（毫秒）
      retry_interval: 1000
      # 最大重连次数
      max_retries: 3
      # 启用压缩
      compression: true

  # Agno框架优化
  agno_optimization:
    # 智能体缓存
    agent_cache:
      enabled: true
      max_size: 50
      ttl: 3600  # 1小时
    
    # 模型实例缓存
    model_cache:
      enabled: true
      max_size: 10
      ttl: 1800  # 30分钟
    
    # 知识库缓存
    knowledge_cache:
      enabled: true
      preload: true
      max_size: 100
    
    # 工具缓存
    tools_cache:
      enabled: true
      max_size: 20

  # 上下文处理优化
  context_processing:
    # 启用异步处理
    async_processing: true
    # 上下文预处理
    preprocess_context: true
    # 上下文压缩
    compress_context: true
    # 最大上下文长度
    max_context_length: 8192
    # 上下文截断策略
    truncation_strategy: "tail"  # head, tail, middle

  # 前端优化建议
  frontend_optimization:
    # 请求合并
    request_batching:
      enabled: true
      batch_size: 5
      wait_time: 100  # 毫秒
    
    # 预测性加载
    predictive_loading:
      enabled: true
      confidence_threshold: 0.7
    
    # 缓存策略
    caching:
      # 启用前端缓存
      enabled: true
      # 缓存生存时间（秒）
      ttl: 300
      # 最大缓存大小
      max_size: "10MB"

  # 监控和诊断
  monitoring:
    # 启用延迟监控
    latency_monitoring: true
    # 详细日志
    detailed_logging: false
    # 性能指标收集
    metrics_collection: true
    # 告警阈值（毫秒）
    alert_thresholds:
      first_token: 2000  # 首token延迟
      total_response: 10000  # 总响应时间
      network_latency: 500  # 网络延迟

# 不同网络环境的优化配置
environment_specific:
  # 高延迟网络环境
  high_latency_network:
    # 增加超时时间
    timeouts:
      connect: 10
      read: 60
      total: 120
    # 增加重试次数
    max_retries: 5
    # 启用激进缓存
    aggressive_caching: true
    
  # 低带宽网络环境  
  low_bandwidth_network:
    # 减少chunk大小
    chunk_size: 256
    # 启用压缩
    compression: true
    # 减少并发连接
    max_connections: 5
    
  # 本地开发环境
  local_development:
    # 禁用某些优化以便调试
    disable_cache: false
    # 增加日志详细度
    verbose_logging: false
    # 禁用SSL验证
    verify_ssl: false