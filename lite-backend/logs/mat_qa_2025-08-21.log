    SELECT COUNT(*) INTO index_count FROM pg_indexes WHERE schemaname = 'public' AND indexname NOT LIKE '%_pkey';
    SELECT COUNT(*) INTO config_count FROM system_configs;
    
    RAISE NOTICE '================================================================';
