d_at': datetime.datetime(2025, 7, 29, 20, 4, 9, 306094)}, {'id': '5c0df14c-d905-410d-81a8-0493774ea63b', 'name': 'activator', 'label': 'activator', 'type': 'activator', 'description': 'An alkaline solution used to initiate the geopolymerization reaction, though not explicitly specified in composition, its insufficiency is inferred from unreacted fly ash particles.', 'properties': {'original_type': 'Activator', 'confidence': 0.8, 'source': 'llm_extraction'}, 'collection': 'entities', 'source_document_id': '6330b137-bed9-4533-86e3-8c45a72dca64', 'created_at': datetime.datetime(2025, 7, 29, 20, 4, 9, 306097)}, {'id': 'e9d242bd-f614-4366-b509-302b12539cd7', 'name': 'unreacted fly ash particles', 'label': 'unreacted fly ash particles', 'type': 'microstructure', 'description': 'Residual raw material observed under SEM, indicating incomplete dissolution due to insufficient activator or low solid-to-liquid ratio.', 'properties': {'original_type': 'Microstructure', 'confidence': 0.8, 'source': 'llm_extraction'}, 'collection': 'entities', 'source_document_id': '6330b137-bed9-4533-86e3-8c45a72dca64', 'created_at': datetime.datetime(2025, 7, 29, 20, 4, 9, 306099)}, {'id': '3e3dc613-8da3-4320-88cb-c168223897c5', 'name': 'SEM observation', 'label': 'SEM observation', 'type': 'characterizationmethod', 'description': 'Scanning Electron Microscopy used to examine the microstructure and identify the presence of unreacted materials in the geopolymer matrix.', 'properties': {'original_type': 'CharacterizationMethod', 'confidence': 0.8, 'source': 'llm_extraction'}, 'collection': 'entities', 'source_document_id': '6330b137-bed9-4533-86e3-8c45a72dca64', 'created_at': datetime.datetime(2025, 7, 29, 20, 4, 9, 306102)}, {'id': 'ccd1830d-221a-44de-bd81-e03e3396d5a7', 'name': 'Vicat apparatus', 'label': 'Vicat apparatus', 'type': 'testingmachine', 'description': 'An instrument used to measure the setting time of cementitious and geopolymeric materials in accordance with ASTM C191.', 'propertie