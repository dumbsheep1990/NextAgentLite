/td><td>1.04</td><td>1.05</td></tr><tr><td>pH</td><td>12.4</td><td>12.0</td></tr></table>', 'chunk_index': 10, 'chunk_metadata': {'strategy': 'semantic', 'type': 'ContentType.TEXT', 'headings': [], 'page_number': [1], 'extra': None}}
