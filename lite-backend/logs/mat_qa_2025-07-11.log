ages/01974484-c8d5-72ac-a6d1-acf6a850ed04_8_626_133_1014_781_0.jpg)', 'chunk_index': 21, 'chunk_metadata': {'strategy': 'semantic', 'type': 'ContentType.TEXT', 'headings': [], 'page_number': [1], 'extra': None}}
