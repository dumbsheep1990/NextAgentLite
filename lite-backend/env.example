# 地聚物材料智能问答系统环境变量配置示例
# 复制此文件为 .env 并填入实际的配置值

# ============================================================================
# 应用环境配置
# ============================================================================
# 应用运行环境: development, production, testing
MAT_QA_ENV="development"

# 应用安全密钥，用于JWT令牌签名等
# 生产环境请使用强随机字符串
SECRET_KEY="your-super-secret-key-change-in-production"

# ============================================================================
# 前端认证配置
# ============================================================================
# 前端登录用户名
FRONTEND_LOGIN_USERNAME="admin"

# 前端登录密码
FRONTEND_LOGIN_PASSWORD="your-secure-password"

# JWT令牌过期时间（分钟）
JWT_EXPIRE_MINUTES="30"

# 是否启用认证
ENABLE_FRONTEND_AUTH="true"

# ============================================================================
# 大语言模型 API 配置
# ============================================================================
# 通义千问 API 密钥
# 获取地址: https://dashscope.aliyun.com/
# QWEN_API_KEY="your-qwen-api-key-here"

# # Google Gemini API 密钥  
# # 获取地址: https://makersuite.google.com/app/apikey
# GEMINI_API_KEY="your-gemini-api-key-here"

# One-API 服务配置
# One-API 统一接口密钥
ONE_API_KEY="your-one-api-key-here"

# One-API 服务基础URL
ONE_API_BASE_URL="http://your-one-api-host:port/v1"

# 默认LLM模型配置（更新为kimi-k2-siliconflow）
DEFAULT_LLM_MODEL="kimi-k2-siliconflow"
DEFAULT_LLM_PROVIDER="alibaba"

# 翻译服务模型配置
# 翻译使用的模型名称
TRANSLATION_MODEL="qwen3-30b-a3b-instruct-2507"
# 翻译模型提供商
TRANSLATION_PROVIDER="oneapi"

# 默认嵌入模型配置
DEFAULT_EMBEDDING_MODEL="text-embedding-v4"
DEFAULT_DOMAIN_EMBEDDING_MODEL="matbert-embedding"

# 统一网关可用模型列表配置（添加新模型）
GATEWAY_MODELS="kimi-k2-siliconflow,qwen3-235b-a22b-instruct-2507,qwen-plus-latest,gpt-4o-mini,gemini-2.5-flash-preview-thinking"
# 模型映射配置
MODEL_ALIASES_KIMI="kimi-k2-siliconflow"
MODEL_ALIASES_QWEN3="qwen3-235b-a22b-instruct-2507"
MODEL_ALIASES_QWEN="qwen-plus-latest"
MODEL_ALIASES_GPT="gpt-4o-mini"
MODEL_ALIASES_GEMINI="gemini-2.5-flash-preview-thinking"
MODEL_ALIASES_EMBEDDING_ALI="text-embedding-v4"
# MODEL_ALIASES_EMBEDDING_OPENAI="text-embedding-3-small,text-embedding-ada-002"

# ============================================================================
# 文本嵌入模型 API 配置
# ============================================================================
# 阿里云文本嵌入 API 密钥  
# 获取地址: https://dashscope.aliyun.com/
# QWEN_EMBEDDING_API_KEY="your-qwen-embedding-api-key-here"
# ALI_EMBEDDING_API_KEY="your-ali-embedding-api-key-here"


# MatBERT 材料工程领域嵌入模型配置
MATBERT_API_KEY="your-matbert-api-key-here"
MATBERT_BASE_URL="http://localhost:8001"
MATBERT_MODEL_NAME="matbert-embedding"

# 自定义嵌入模型配置
CUSTOM_EMBEDDING_API_KEY="your-custom-embedding-api-key-here"
CUSTOM_EMBEDDING_BASE_URL="http://localhost:8002"

# ============================================================================
# PostgreSQL 数据库配置
# ============================================================================
# 数据库主机地址
POSTGRESQL_HOST="localhost"

# 数据库端口
POSTGRESQL_PORT="5432"

# 数据库名称
POSTGRESQL_DATABASE="mat_demo"

# 数据库用户名
POSTGRESQL_USERNAME="mat_demo"

# 数据库密码
POSTGRESQL_PASSWORD="your-database-password"

# ============================================================================
# ElasticSearch 配置
# ============================================================================
# ElasticSearch 完整URL
ELASTICSEARCH_URL="https://localhost:9200"

# ElasticSearch 用户名
ELASTICSEARCH_USERNAME="elastic"

# ElasticSearch 密码
ELASTICSEARCH_PASSWORD="your-elasticsearch-password"

# ElasticSearch API Key
ELASTICSEARCH_API_KEY="your-elasticsearch-api-key"

# ============================================================================
# ArangoDB 图数据库配置
# ============================================================================
# ArangoDB 服务器地址
ARANGODB_URL="http://localhost:8529"

# ArangoDB 数据库名称
ARANGODB_DATABASE="mat_qa_graph"

# ArangoDB 用户名
ARANGODB_USERNAME="root"

# ArangoDB 密码
ARANGODB_PASSWORD="your-arangodb-password"

# ============================================================================
# MinIO 对象存储配置
# ============================================================================
# 是否启用MinIO存储（true/false）
MINIO_ENABLED="true"

# MinIO 服务端点
MINIO_ENDPOINT="localhost:9000"

# MinIO 访问密钥
MINIO_ACCESS_KEY="admin"

# MinIO 秘密密钥
MINIO_SECRET_KEY="your-minio-secret-key"

# 是否使用HTTPS（true/false）
MINIO_SECURE="false"

# 存储区域
# MINIO_REGION="us-east-1"

# 文档存储桶名称
MINIO_DOCUMENTS_BUCKET="mat-qa-documents"

# 媒体文件存储桶名称
MINIO_MEDIA_BUCKET="mat-qa-media"

# 缩略图存储桶名称
MINIO_THUMBNAILS_BUCKET="mat-qa-thumbnails"

# 知识图谱文档存储桶名称
MINIO_KNOWLEDGE_GRAPH_BUCKET="mat-qa-knowledge-graph"

# 公共访问端点
MINIO_PUBLIC_ENDPOINT="http://localhost:9000"

# CDN端点（可选）
# MINIO_CDN_ENDPOINT="https://cdn.example.com"

# 预签名URL过期时间（秒）
MINIO_PRESIGNED_URL_EXPIRES="3600"

# 是否自动创建存储桶（true/false）
MINIO_AUTO_CREATE_BUCKETS="true"

# ============================================================================
# 可选配置
# ============================================================================
# 日志级别: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL="INFO"

# API服务监听端口
API_PORT="8000"

# API服务监听地址
API_HOST="0.0.0.0"

# 跨域请求允许的域名列表（逗号分隔）
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# 上传文件大小限制（MB）
MAX_UPLOAD_SIZE="50"

# ============================================================================
# PDF 预处理（OpenDataLoader PDF CLI）
# ============================================================================
# 是否启用 ODL PDF 预处理（true/false）
ENABLE_ODL_PDF_PREPROCESS="true"
# ODL CLI jar 路径
ODL_JAR_PATH="./lite-backend/opendataloader/opendataloader-pdf-cli-1.0.6.jar"
# ODL 输出目录（本地临时产物，便于排查）
ODL_BASE_OUTPUT_DIR="./lite-backend/logs/odl"
# 预处理选项
ODL_KEEP_LINE_BREAKS="true"
ODL_MARKDOWN_WITH_HTML="true"
ODL_MARKDOWN_WITH_IMAGES="false"
# 关闭内容安全过滤（留空或填 all/hidden-text/off-page/tiny/hidden-ocg）
ODL_CONTENT_SAFETY_OFF=""
# 将非法字符替换为
ODL_REPLACE_INVALID_CHARS=" "
# 处理超时时间（秒）
ODL_PROCESS_TIMEOUT="90"

# ============================================================================
# Redis（可选）— 知识库任务状态与SSE桥接
# ============================================================================
# 如配置以下任一变量，则启用Redis增强能力：
# - 保存任务快照（进度/阶段/详情）
# - 任务取消标记（跨进程即时生效）
# - SSE跨实例桥接（发布/订阅）

# Redis连接串（任意其一即可）
# 一般使用：
# REDIS_URL="redis://127.0.0.1:6379/0"
# 或者为知识库子系统单独指定：
# REDIS_KNOWLEDGE_URL="redis://127.0.0.1:6379/0"

# 任务快照TTL（秒），默认86400（24小时）
# REDIS_KNOWLEDGE_TTL="86400"

# 统一模型网关（llm-config-gateway）
# 本地默认: http://127.0.0.1:9050
LLM_CONFIG_GATEWAY_URL="http://127.0.0.1:9050"

# ============================================================================
# Unla 统一网关 / MCP 集成配置
# ============================================================================
# Unla Apiserver 地址（用于OpenAPI导入、配置同步）
UNLA_APISERVER_URL="http://127.0.0.1:5234"

# Unla MCP Gateway 地址（实际网关服务端口）
UNLA_GATEWAY_URL="http://127.0.0.1:5235"

# 后端对外统一反向代理前缀（无需修改，后端已挂载 /gateway/* → UNLA_GATEWAY_URL）
UNLA_GATEWAY_PREFIX="/gateway"

# Unla 超级管理员账号（用于apiserver登录）
UNLA_SUPER_ADMIN_USERNAME="admin"
UNLA_SUPER_ADMIN_PASSWORD="admin"

# Unla 默认租户名称
UNLA_TENANT_DEFAULT="default"

# 是否为Agent启用 MCP 工具（默认启用）
ENABLE_MCP_TOOLS="true"

# ============================================================================
# 任务并发和批处理配置
# ============================================================================
# 增强任务管理器最大并发任务数
MAX_CONCURRENT_TASKS="3"

# 批量文档处理的最大批次大小
MAX_BATCH_DOCUMENT_SIZE="5"

# 向量化处理的批次大小（每批处理的分块数量）
VECTORIZATION_BATCH_SIZE="5"

# QA数据集处理的批次大小
QA_DATASET_BATCH_SIZE="10"

# 向量化任务之间的延迟时间（秒）
VECTORIZATION_DELAY="0.1"

# 任务心跳间隔（秒）
TASK_HEARTBEAT_INTERVAL="30"

# 任务锁超时时间（秒）
TASK_LOCK_TIMEOUT="300"

# 工作进程最大重试次数
MAX_TASK_RETRIES="3"

# 任务过期时间（小时）
TASK_EXPIRES_HOURS="24"
