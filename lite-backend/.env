# NextAgent Lite环境变量配置示例
# 复制此文件为 .env 并填入实际的配置值

# ============================================================================
# 应用环境配置
# ============================================================================
# 应用运行环境: development, production, testing
MAT_QA_ENV=development

# 应用安全密钥，用于JWT令牌签名等
# 生产环境请使用强随机字符串
SECRET_KEY="your-super-secret-key-change-in-production"

# ============================================================================
# 前端认证配置
# ============================================================================
# 系统用户配置 (username:password:role:displayName)
# admin用户 - 系统管理员
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="admin123"
ADMIN_ROLE="admin"  
ADMIN_DISPLAY_NAME="管理员"

# user1用户 - 用户1
RESEARCHER1_USERNAME="user1"
RESEARCHER1_PASSWORD="user123"
RESEARCHER1_ROLE="user"
RESEARCHER1_DISPLAY_NAME="用户1"

# user2用户 - 用户2  
RESEARCHER2_USERNAME="user2"
RESEARCHER2_PASSWORD="user123"
RESEARCHER2_ROLE="user"
RESEARCHER2_DISPLAY_NAME="用户2"

# guest用户 - 访客
RESEARCHER3_USERNAME="guest"
RESEARCHER3_PASSWORD="guest123"
RESEARCHER3_ROLE="guest"
RESEARCHER3_DISPLAY_NAME="访客"

# 前端登录用户名 (保持兼容性)
FRONTEND_LOGIN_USERNAME="admin"

# 前端登录密码 (保持兼容性)
FRONTEND_LOGIN_PASSWORD="admin123"

# JWT令牌过期时间（分钟）
JWT_EXPIRE_MINUTES="30"

# 是否启用认证
ENABLE_FRONTEND_AUTH="true"

# ============================================================================
# 大语言模型 API 配置
# ============================================================================
# 通义千问 API 密钥
# 获取地址: https://dashscope.aliyun.com/
# QWEN_API_KEY=your-qwen-api-key-here

# # Google Gemini API 密钥  
# # 获取地址: https://makersuite.google.com/app/apikey
# GEMINI_API_KEY=your-gemini-api-key-here

# One-API 服务配置
# One-API 统一接口密钥
ONE_API_KEY="sk-mnennlifdngjififromhljflqsblutyfgfvwerkfhsxummcn"

# One-API 服务基础URL
ONE_API_BASE_URL="https://api.siliconflow.cn/v1"

# 默认LLM模型配置 - 用于问答场景
DEFAULT_LLM_MODEL="Qwen/Qwen3-30B-A3B-Thinking-2507"
DEFAULT_LLM_PROVIDER="alibaba"

# 翻译服务模型配置
# 翻译使用的模型名称
TRANSLATION_MODEL="Qwen/Qwen3-30B-A3B-Thinking-2507"
# 翻译模型提供商
TRANSLATION_PROVIDER="oneapi"

# 默认嵌入模型配置
DEFAULT_EMBEDDING_MODEL="Qwen/Qwen3-Embedding-4B"

# 统一网关可用模型列表配置
GATEWAY_MODELS="Qwen/Qwen3-30B-A3B-Instruct-2507,Qwen/Qwen3-30B-A3B-Thinking-2507,Qwen/Qwen3-235B-A22B-Thinking-2507,Qwen/Qwen3-30B-A3B,moonshotai/Kimi-K2-Instruct,deepseek-ai/DeepSeek-V3"
# 模型映射配置
MODEL_ALIASES_QWEN="qwen-plus-latest"
MODEL_ALIASES_GPT="gpt-4o-mini"
MODEL_ALIASES_GEMINI="gemini-2.5-flash-preview-thinking,gemini-2.5-flash-preview-nothinking"
MODEL_ALIASES_EMBEDDING_ALI="text-embedding-v4"
# MODEL_ALIASES_EMBEDDING_OPENAI=text-embedding-3-small,text-embedding-ada-002

# ============================================================================
# 智能体团队(Team)模式默认配置
# ============================================================================
# Team模式默认模型 - 用于所有Team中的Agent（除翻译Agent外）
TEAM_DEFAULT_MODEL="Qwen/Qwen3-30B-A3B-Thinking-2507"

# Team模式默认团队名称 - 当用户选择Team模式但未指定具体团队时使用
TEAM_DEFAULT_NAME="Qwen/Qwen3-30B-A3B-Thinking-2507"

# Team翻译Agent专用模型（保持使用Gemini以获得更好的翻译质量）
TEAM_TRANSLATION_MODEL="Qwen/Qwen3-30B-A3B-Thinking-2507"

# ============================================================================
# 文本嵌入模型 API 配置
# ============================================================================
# 阿里云文本嵌入 API 密钥  
# 获取地址: https://dashscope.aliyun.com/
# QWEN_EMBEDDING_API_KEY=your-qwen-embedding-api-key-here
# ALI_EMBEDDING_API_KEY=your-ali-embedding-api-key-here



# 自定义嵌入模型配置
CUSTOM_EMBEDDING_API_KEY="your-custom-embedding-api-key-here"
CUSTOM_EMBEDDING_BASE_URL="http://localhost:8002"

# ============================================================================
# 重排序模型配置
# ============================================================================
# 阿里云百炼重排序模型API密钥
ALIBABA_BAILIAN_RERANK_API_KEY="sk-8eccdd68eb4e4e26aeb482473b99dbee"

# 阿里云百炼重排序模型基础URL
ALIBABA_BAILIAN_RERANK_BASE_URL="https://dashscope.aliyuncs.com"

# 默认重排序模型名称
DEFAULT_RERANK_MODEL="Qwen/Qwen3-Reranker-4B"

# 重排序模型提供商
DEFAULT_RERANK_PROVIDER="oneapi"

# 重排序模型可用列表
RERANK_MODELS="Qwen/Qwen3-Reranker-4B"

# ============================================================================
# PostgreSQL 数据库配置
# ============================================================================
# 数据库主机地址
POSTGRESQL_HOST="localhost"

# 数据库端口
POSTGRESQL_PORT="5434"

# 数据库名称
POSTGRESQL_DATABASE="zzdsj_demo"

# 数据库用户名
POSTGRESQL_USERNAME="zzdsj_demo"

# 数据库密码
POSTGRESQL_PASSWORD="zzdsj123!"

# ============================================================================
# ElasticSearch 配置
# ============================================================================
# ElasticSearch 完整URL
ELASTICSEARCH_URL="http://localhost:9200"

# ElasticSearch 用户名
# ELASTICSEARCH_USERNAME="elastic"

# ElasticSearch 密码
# ELASTICSEARCH_PASSWORD="n_pehJf6G7WsW4=5zkpq"

# ElasticSearch API Key (可选，如果使用API Key认证)
# ELASTICSEARCH_API_KEY=""

# ArangoDB 配置已移除，使用 PostgreSQL 作为主要数据库

# ============================================================================
# Redis 缓存和队列配置
# ============================================================================
# Redis 服务器地址
REDIS_HOST="localhost"

# Redis 服务器端口
REDIS_PORT="6379"

# Redis 数据库编号 (0-15)
REDIS_DB="0"

# Redis 密码
# REDIS_PASSWORD="zzdsj123"

# Redis 连接超时时间（秒）
REDIS_TIMEOUT="10"

# Redis 连接池最大连接数
REDIS_MAX_CONNECTIONS="20"

# ============================================================================
# Milvus 向量数据库配置
# ============================================================================
# Milvus 服务器地址
MILVUS_HOST="localhost"

# Milvus 服务器端口
MILVUS_PORT="19530"

# Milvus 用户名（如果启用认证）
# MILVUS_USERNAME=""

# Milvus 密码（如果启用认证）
# MILVUS_PASSWORD=""

# Milvus 连接超时时间（秒）
MILVUS_TIMEOUT="30"

# ============================================================================
# MinIO 对象存储配置
# ============================================================================
# 是否启用MinIO存储（true/false）
MINIO_ENABLED="true"

# MinIO 服务端点
MINIO_ENDPOINT="localhost:9000"

# MinIO 访问密钥
MINIO_ACCESS_KEY="zzdsjadmin"

# MinIO 秘密密钥
MINIO_SECRET_KEY="zzdsjadmin"

# 是否使用HTTPS（true/false）
MINIO_SECURE="false"

# 存储区域
# MINIO_REGION=us-east-1

# 文档存储桶名称
MINIO_DOCUMENTS_BUCKET="policy-qa-documents"

# 媒体文件存储桶名称
MINIO_MEDIA_BUCKET="policy-qa-media"

# 缩略图存储桶名称
MINIO_THUMBNAILS_BUCKET="policy-qa-thumbnails"

# 知识图谱存储桶名称
MINIO_KNOWLEDGE_GRAPH_BUCKET="policy-qa-knowledge-graph"

# 分析报告存储桶名称
MINIO_REPORTS_BUCKET="policy-qa-reports"

# 系统备份存储桶名称
MINIO_BACKUPS_BUCKET="policy-qa-backups"

# 系统日志存储桶名称
MINIO_LOGS_BUCKET="policy-qa-logs"

# 缓存文件存储桶名称
MINIO_CACHE_BUCKET="policy-qa-cache"

# 公共访问端点
MINIO_PUBLIC_ENDPOINT="http://localhost:9000"

# CDN端点（可选）
# MINIO_CDN_ENDPOINT="https://cdn.example.com"

# 预签名URL过期时间（秒）
MINIO_PRESIGNED_URL_EXPIRES="3600"

# 是否自动创建存储桶（true/false）
MINIO_AUTO_CREATE_BUCKETS="false"
MINIO_SKIP_BUCKET_VALIDATION=true


# ============================================================================
# 可选配置
# ============================================================================
# 日志级别: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL="INFO"

# API服务监听端口
API_PORT="8000"

# API服务监听地址
API_HOST="0.0.0.0"

# 跨域请求允许的域名列表（逗号分隔）
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# 上传文件大小限制（MB）
MAX_UPLOAD_SIZE="50"

# ============================================================================
# 队列和并发处理配置
# ============================================================================
# 文件处理队列最大并发数
QUEUE_MAX_CONCURRENT_TASKS=2

# 文档向量化最大并发数
DOCUMENT_VECTORIZATION_CONCURRENCY=2

# QA数据集向量化最大并发数  
QA_VECTORIZATION_CONCURRENCY=1

# 向量化处理批次大小
VECTORIZATION_BATCH_SIZE=10

# 队列任务超时时间（秒）
QUEUE_TASK_TIMEOUT=3600

# 队列重试次数
QUEUE_MAX_RETRIES=3

# 大文件处理队列最大并发数（文件大小超过2MB时使用）
LARGE_FILE_MAX_CONCURRENT_TASKS=1

# 大文件阈值（字节），超过此大小的文件使用大文件队列设置（2MB）
LARGE_FILE_THRESHOLD=2097152

# ============================================================================
# 知识图谱三元组提取配置
# ============================================================================
# 知识图谱专用LLM模型配置
# 三元组提取默认模型 - 使用qwen3-30b模型，专门用于实体关系提取
KNOWLEDGE_GRAPH_DEFAULT_MODEL="Qwen/Qwen3-30B-A3B-Thinking-2507"
KNOWLEDGE_GRAPH_DEFAULT_PROVIDER="oneapi"

# 知识图谱模型优先级列表（按优先级排序，逗号分隔）
# 系统会按顺序选择第一个可用的模型
KNOWLEDGE_GRAPH_MODEL_PRIORITY="Qwen/Qwen3-30B-A3B-Thinking-2507,Qwen/Qwen3-30B-A3B-Instruct-2507,Qwen/Qwen3-235B-A22B-Thinking-2507,deepseek-ai/DeepSeek-V3"

# 三元组提取最大并发数（文档块并发处理数量）
# 建议值: 1-5，过高可能导致API限流
TRIPLET_EXTRACTION_MAX_CONCURRENT=3

# 三元组提取批次大小（每批次处理的文档块数量）
# 当文档块数量超过此值时，会分批并发处理
TRIPLET_EXTRACTION_BATCH_SIZE=3

# LLM API调用超时时间（秒）
# 三元组提取单次LLM调用的最大等待时间
TRIPLET_EXTRACTION_TIMEOUT=60

# 启用三元组提取调试日志
# true: 记录LLM原始输出和详细解析过程
# false: 仅记录基本处理信息
TRIPLET_EXTRACTION_DEBUG=true

# 三元组提取重试次数
# LLM调用失败时的最大重试次数
TRIPLET_EXTRACTION_MAX_RETRIES=2

# ============================================================================
# 前端配置
# ============================================================================
# 前端服务地址（用于SSE连接）
FRONTEND_BASE_URL="http://localhost:3000"

# 后端API地址（前端用于连接SSE）
BACKEND_API_URL="http://localhost:8000"

# SSE连接超时时间（毫秒）
SSE_CONNECTION_TIMEOUT=30000

# 兼容旧配置
MAX_CONCURRENT_TASKS=5

# ============================================================================
# MatGraph 知识图谱服务配置
# ============================================================================
# MatGraph 服务配置
MATGRAPH_HOST="0.0.0.0"
MATGRAPH_PORT="9622"

# MatGraph 客户端连接配置 (后端连接MatGraph服务的地址)
MATGRAPH_SERVICE_URL="http://localhost:9622"
MATGRAPH_WEBUI_TITLE="MatGraph 知识图谱系统"
MATGRAPH_WEBUI_DESCRIPTION="基于 LightRAG 的材料科学知识图谱系统"

# MatGraph 工作目录配置 (使用MatGraph目录下的数据)
# 注意：这些路径是相对于MatGraph目录的，因为MatGraph服务在MatGraph目录下运行
MATGRAPH_WORKING_DIR="./rag_storage_test"
MATGRAPH_INPUT_DIR="./inputs_test"
MATGRAPH_WORKSPACE=""

# MatGraph LLM 配置 (使用统一的模型配置)
MATGRAPH_LLM_BINDING="openai"
MATGRAPH_LLM_MODEL="Qwen/Qwen3-235B-A22B-Thinking-2507"
MATGRAPH_LLM_BINDING_HOST="https://api.siliconflow.cn/v1"
MATGRAPH_LLM_BINDING_API_KEY="sk-mnennlifdngjififromhljflqsblutyfgfvwerkfhsxummcn"
MATGRAPH_TEMPERATURE="0.1"
MATGRAPH_TIMEOUT="240"

# MatGraph 嵌入模型配置
MATGRAPH_EMBEDDING_BINDING="openai"
MATGRAPH_EMBEDDING_BINDING_HOST="https://api.siliconflow.cn/v1"
MATGRAPH_EMBEDDING_BINDING_API_KEY="sk-mnennlifdngjififromhljflqsblutyfgfvwerkfhsxummcn"
MATGRAPH_EMBEDDING_MODEL="Qwen/Qwen3-Embedding-4B"
MATGRAPH_EMBEDDING_DIM="2048"

# MatGraph 重排序模型配置
RERANK_BINDING_API_KEY="sk-8eccdd68eb4e4e26aeb482473b99dbee"
RERANK_BINDING_HOST="https://dashscope.aliyuncs.com"
RERANK_MODEL="gte-rerank-v2"
MIN_RERANK_SCORE="0.0"

# MatGraph 存储配置
MATGRAPH_KV_STORAGE="JsonKVStorage"
MATGRAPH_DOC_STATUS_STORAGE="JsonDocStatusStorage"
MATGRAPH_GRAPH_STORAGE="NetworkXStorage"
MATGRAPH_VECTOR_STORAGE="NanoVectorDBStorage"

# MatGraph 处理配置
MATGRAPH_SUMMARY_LANGUAGE="Chinese"
MATGRAPH_ENABLE_LLM_CACHE="True"
MATGRAPH_CHUNK_SIZE="1200"
MATGRAPH_CHUNK_OVERLAP_SIZE="100"
MATGRAPH_MAX_ASYNC="4"
MATGRAPH_TOP_K="40"
MATGRAPH_CHUNK_TOP_K="10"

