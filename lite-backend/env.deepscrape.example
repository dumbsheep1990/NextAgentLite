# DeepScrape服务配置示例
# 复制此文件为 .env 并修改配置值

# =============================================================================
# DeepScrape 服务配置
# =============================================================================

# DeepScrape服务地址（避免与前端端口3000冲突）
DEEPSCRAPE_BASE_URL=http://localhost:3001

# DeepScrape API密钥
DEEPSCRAPE_API_KEY=your-secret-key

# DeepScrape请求超时时间（秒）
DEEPSCRAPE_TIMEOUT=30

# 是否启用DeepScrape服务
DEEPSCRAPE_ENABLED=false

# DeepScrape默认配置
DEEPSCRAPE_DEFAULT_EXTRACTOR_FORMAT=markdown
DEEPSCRAPE_DEFAULT_WAIT_TIMEOUT=5000
DEEPSCRAPE_DEFAULT_STEALTH_MODE=true
DEEPSCRAPE_DEFAULT_CONCURRENCY=3
DEEPSCRAPE_MAX_BATCH_SIZE=100

# =============================================================================
# 集成指南
# =============================================================================

# 1. 部署DeepScrape服务
#    - 克隆项目: git clone https://github.com/stretchcloud/deepscrape.git
#    - 安装依赖: npm install
#    - 配置环境变量: cp .env.example .env
#    - 修改端口: 在.env中设置 PORT=3001 (避免与前端3000端口冲突)
#    - 启动服务: npm run dev

# 2. 配置LLM提供商（选择其一）
#    
#    选项1: 使用OpenAI
#    LLM_PROVIDER=openai
#    OPENAI_API_KEY=your-openai-key
#    
#    选项2: 使用本地Ollama
#    LLM_PROVIDER=ollama
#    LLM_BASE_URL=http://localhost:11434/v1
#    LLM_MODEL=llama3:latest
#    
#    选项3: 使用阿里云（OpenAI兼容）
#    LLM_PROVIDER=openai
#    OPENAI_API_KEY=your-alibaba-api-key
#    OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 3. 可选：配置Redis（用于任务队列）
#    REDIS_HOST=localhost
#    REDIS_PORT=6379

# 4. 启用DeepScrape服务
#    修改上面的 DEEPSCRAPE_ENABLED=true

# =============================================================================
# 使用示例
# =============================================================================

# API调用示例：
# 
# 1. 标准抓取
# POST /api/v1/url-crawl/crawl
# {
#   "urls": ["https://example.com"],
#   "engine": "deepscrape",
#   "options": {
#     "extractorFormat": "markdown",
#     "stealthMode": true
#   }
# }
#
# 2. 智能抓取和结构化抽取
# POST /api/v1/url-crawl/deepscrape
# {
#   "urls": ["https://news.example.com"],
#   "extraction_schema": {
#     "type": "object",
#     "properties": {
#       "title": {"type": "string"},
#       "author": {"type": "string"},
#       "publishDate": {"type": "string"}
#     }
#   }
# }
#
# 3. 内容摘要生成
# POST /api/v1/url-crawl/deepscrape
# {
#   "urls": ["https://blog.example.com"],
#   "summary_enabled": true,
#   "max_summary_length": 300
# }

# =============================================================================
# 性能优化建议
# =============================================================================

# 1. 并发控制
#    - 单页面爬取: concurrency=1
#    - 批量爬取: concurrency=3-5
#    - 大规模爬取: concurrency=10+

# 2. 超时设置
#    - 简单页面: waitForTimeout=2000
#    - 复杂页面: waitForTimeout=5000-10000
#    - 单页应用: waitForTimeout=10000+

# 3. 缓存策略
#    - 开发环境: CACHE_ENABLED=true, CACHE_TTL=3600
#    - 生产环境: 根据实际需求调整TTL

# 4. 资源限制
#    - 内存使用: 监控Node.js进程内存
#    - 网络带宽: 控制并发数避免带宽瓶颈
#    - 存储空间: 定期清理缓存文件