          "expires_at": 1723466400
        }
      },
      "rate_limit": {
        "description": "速率限制存储",
        "key_pattern": "rate_limit:{service}:{identifier}:{time_window}",
        "ttl": "dynamic",
        "data_structure": {
          "count": "integer - 当前计数",
          "limit": "integer - 限制值",
          "window_start": "integer - 时间窗口开始",
          "window_size": "integer - 时间窗口大小"
