{
  "redis_key_design": {
    "version": "1.3.2",
    "description": "MAT-DEMO地聚物材料智能问答系统Redis键命名规范和设计模板",
    "created_at": "2025-08-12",
    "connection_settings": {
      "host": "localhost",
      "port": 6379,
      "db": 0,
      "password": "",
      "timeout": 10,
      "max_connections": 20,
      "connection_pool": {
        "max_connections": 200,
        "socket_timeout": 30.0,
        "socket_connect_timeout": 10.0,
        "retry_attempts": 3
      }
    },
    "key_naming_conventions": {
      "general_rules": {
        "separator": ":",
        "encoding": "utf-8",
        "case_style": "snake_case",
        "max_key_length": 512,
        "prefix_required": true,
        "workspace_support": true
      },
      "key_structure": "workspace_namespace:entity_type:identifier[:sub_type][:additional_info]",
      "examples": {
        "with_workspace": "matgraph_geopolymer_text_chunks:chunk_001:metadata",
        "without_workspace": "text_chunks:chunk_001:metadata",
        "complex_key": "matgraph_cache:search_mode:hybrid:query_hash_abc123"
      }
    },
    "namespace_definitions": {
      "text_chunks": {
        "description": "文档文本块存储",
        "key_pattern": "{workspace_}text_chunks:{chunk_id}",
        "data_structure": {
          "_id": "string - chunk唯一标识",
          "content": "string - 文本内容",
          "document_id": "string - 所属文档ID",
          "chunk_index": "integer - 块索引",
          "metadata": "object - 元数据",
          "create_time": "integer - 创建时间戳",
          "update_time": "integer - 更新时间戳",
          "llm_cache_list": "array - LLM缓存列表"
        },
        "example_key": "text_chunks:doc_001_chunk_05",
        "example_data": {
          "_id": "doc_001_chunk_05",
          "content": "地聚物是一种新型绿色建筑材料...",
          "document_id": "doc_001",
          "chunk_index": 5,
          "metadata": {
            "page": 3,
            "section": "introduction",
            "language": "zh"
          },
          "create_time": 1723459200,
          "update_time": 1723459200,
          "llm_cache_list": []
        }
      },
      "text_chunks_status": {
        "description": "文档处理状态存储",
        "key_pattern": "{workspace_}text_chunks_status:{doc_id}",
        "data_structure": {
          "status": "string - 处理状态 (pending|processing|completed|failed)",
          "file_path": "string - 文件路径",
          "metadata": "object - 文档元数据",
          "error_msg": "string - 错误信息",
          "chunks_list": "array - 分块ID列表",
          "track_id": "string - 追踪ID",
          "updated_at": "string - 更新时间",
          "created_at": "string - 创建时间"
        },
        "status_values": ["pending", "processing", "completed", "failed"],
        "example_key": "text_chunks_status:doc_001",
        "example_data": {
          "status": "completed",
          "file_path": "/uploads/documents/research_paper.pdf",
          "metadata": {
            "title": "地聚物材料性能研究",
            "author": "张三",
            "pages": 15
          },
          "error_msg": null,
          "chunks_list": ["doc_001_chunk_01", "doc_001_chunk_02"],
          "track_id": "track_12345",
          "updated_at": "2025-08-12T10:00:00Z",
          "created_at": "2025-08-12T09:30:00Z"
        }
      },
      "cache": {
        "description": "LLM缓存存储",
        "key_pattern": "{workspace_}cache:{mode}:{cache_type}:{hash}",
        "modes": ["naive", "local", "global", "hybrid", "mix"],
        "cache_types": ["extract", "query", "response", "embedding"],
        "data_structure": {
          "return": "any - 缓存的返回值",
          "cache_type": "string - 缓存类型",
          "timestamp": "integer - 缓存时间戳",
          "expires_at": "integer - 过期时间戳",
          "access_count": "integer - 访问次数",
          "metadata": "object - 附加元数据"
        },
        "example_key": "cache:hybrid:extract:a1b2c3d4e5f6",
        "example_data": {
          "return": {
            "entities": ["地聚物", "建筑材料"],
            "relations": [["地聚物", "是", "建筑材料"]],
            "confidence": 0.95
          },
          "cache_type": "extract",
          "timestamp": 1723459200,
          "expires_at": 1723545600,
          "access_count": 3,
          "metadata": {
            "model": "qwen3-30b",
            "query_length": 150
          }
        }
      },
      "kv_store": {
        "description": "通用键值存储",
        "key_pattern": "{workspace_}kv_store:{category}:{key}",
        "categories": ["config", "session", "temp", "user_data"],
        "data_structure": {
          "_id": "string - 键标识",
          "value": "any - 存储值",
          "create_time": "integer - 创建时间",
          "update_time": "integer - 更新时间",
          "metadata": "object - 元数据"
        },
        "example_key": "kv_store:config:default_embedding_model",
        "example_data": {
          "_id": "default_embedding_model",
          "value": "text-embedding-v4",
          "create_time": 1723459200,
          "update_time": 1723459200,
          "metadata": {
            "category": "config",
            "description": "默认嵌入模型配置"
          }
        }
      },
      "session": {
        "description": "用户会话存储",
        "key_pattern": "session:{session_id}",
        "ttl": 3600,
        "data_structure": {
          "user_id": "string - 用户ID",
          "conversation_id": "string - 对话ID",
          "context": "object - 对话上下文",
          "preferences": "object - 用户偏好",
          "created_at": "integer - 创建时间",
          "last_activity": "integer - 最后活跃时间"
        },
        "example_key": "session:sess_abc123def456",
        "example_data": {
          "user_id": "user_001",
          "conversation_id": "conv_123",
          "context": {
            "current_topic": "地聚物强度",
            "message_count": 5,
            "language": "zh"
          },
          "preferences": {
            "search_mode": "hybrid",
            "response_detail": "detailed"
          },
          "created_at": 1723459200,
          "last_activity": 1723462800
        }
      },
      "agent_memory": {
        "description": "Agent记忆存储",
        "key_pattern": "agent_memory:{session_id}:{user_id}",
        "data_structure": {
          "session_id": "string - 会话ID",
          "user_id": "string - 用户ID",
          "memory": "object - 记忆数据",
          "created_at": "integer - 创建时间",
          "updated_at": "integer - 更新时间"
        },
        "example_key": "agent_memory:sess_123:user_001",
        "example_data": {
          "session_id": "sess_123",
          "user_id": "user_001",
          "memory": {
            "conversation_history": [],
            "user_preferences": {},
            "context_stack": []
          },
          "created_at": 1723459200,
          "updated_at": 1723459200
        }
      },
      "team_execution": {
        "description": "Team执行状态存储",
        "key_pattern": "team_execution:{execution_id}",
        "ttl": 86400,
        "data_structure": {
          "execution_id": "string - 执行ID",
          "team_name": "string - 团队名称",
          "status": "string - 执行状态",
          "progress": "object - 执行进度",
          "results": "object - 执行结果",
          "start_time": "integer - 开始时间",
          "end_time": "integer - 结束时间"
        },
        "example_key": "team_execution:exec_abc123",
        "example_data": {
          "execution_id": "exec_abc123",
          "team_name": "geopolymer_qa_team_v2",
          "status": "completed",
          "progress": {
            "completed_steps": 5,
            "total_steps": 5,
            "current_agent": null
          },
          "results": {
            "answer": "地聚物具有优异的力学性能...",
            "confidence": 0.92,
            "sources": []
          },
          "start_time": 1723459200,
          "end_time": 1723459260
        }
      },
      "retrieval_cache": {
        "description": "检索结果缓存",
        "key_pattern": "retrieval_cache:{query_hash}",
        "ttl": 3600,
        "data_structure": {
          "query": "string - 查询文本",
          "query_hash": "string - 查询哈希",
          "results": "array - 检索结果",
          "metadata": "object - 检索元数据",
          "created_at": "integer - 创建时间",
          "expires_at": "integer - 过期时间",
          "hit_count": "integer - 命中次数"
        },
        "example_key": "retrieval_cache:query_hash_abc123",
        "example_data": {
          "query": "地聚物强度测试方法",
          "query_hash": "query_hash_abc123",
          "results": [
            {
              "id": "chunk_001",
              "content": "地聚物强度测试采用...",
              "score": 0.95,
              "document_id": "doc_001"
            }
          ],
          "metadata": {
            "search_mode": "hybrid",
            "top_k": 10,
            "threshold": 0.7,
            "total_matches": 25
          },
          "created_at": 1723459200,
          "expires_at": 1723462800,
          "hit_count": 1
        }
      },
      "model_cache": {
        "description": "模型推理缓存",
        "key_pattern": "model_cache:{model_name}:{input_hash}",
        "ttl": 7200,
        "data_structure": {
          "model_name": "string - 模型名称",
          "input_hash": "string - 输入哈希",
          "output": "any - 模型输出",
          "metadata": "object - 推理元数据",
          "created_at": "integer - 创建时间",
          "expires_at": "integer - 过期时间"
        },
        "example_key": "model_cache:qwen3-30b:input_hash_xyz789",
        "example_data": {
          "model_name": "qwen3-30b",
          "input_hash": "input_hash_xyz789",
