{
  "minio_storage_design": {
    "version": "2.0.0",
    "description": "NextAgent Lite MinIO对象存储设计配置",
    "created_at": "2025-01-11",
    "connection_settings": {
      "development": {
        "endpoint": "localhost:9000",
        "access_key": "minioadmin",
        "secret_key": "minioadmin",
        "secure": false,
        "region": "us-east-1",
        "public_endpoint": "http://localhost:9000",
        "console_port": 9001
      },
      "production": {
        "endpoint": "103.6.168.6:9000",
        "access_key": "minio",
        "secret_key": "minio123",
        "secure": false,
        "region": "us-east-1",
        "public_endpoint": "http://103.6.168.6:9000",
        "console_port": 9001
      },
      "docker": {
        "endpoint": "minio:9000",
        "access_key": "minio",
        "secret_key": "minio123",
        "secure": false,
        "region": "us-east-1",
        "public_endpoint": "http://minio:9000",
        "console_port": 9001
      }
    },
    "bucket_definitions": {
      "policy-qa-documents": {
        "description": "政策文档存储桶",
        "purpose": "存储政策法规文件、政府通知、行业标准等政策文档",
        "versioning": true,
        "lifecycle_policy": {
          "enabled": true,
          "rules": [
            {
              "id": "cleanup_incomplete_uploads",
              "status": "Enabled",
              "abort_incomplete_multipart_upload": {
                "days_after_initiation": 7
              }
            },
            {
              "id": "archive_old_versions",
              "status": "Enabled",
              "noncurrent_version_expiration": {
                "noncurrent_days": 30
              }
            }
          ]
        },
        "notification_config": {
          "events": ["s3:ObjectCreated:*", "s3:ObjectRemoved:*"],
          "filter_prefix": "",
          "filter_suffix": ""
        },
        "cors_config": {
          "allowed_origins": ["*"],
          "allowed_methods": ["GET", "POST", "PUT", "DELETE"],
          "allowed_headers": ["*"],
          "expose_headers": ["ETag"],
          "max_age_seconds": 3600
        },
        "example_objects": [
          "policies/tax/2025/01/个人所得税法实施条例.pdf",
          "policies/business/2025/01/企业注册管理办法.docx",
          "policies/labor/2025/01/劳动法修正案.pdf",
          "policies/temp/draft_policy_review.txt"
        ]
      },
      "policy-qa-media": {
        "description": "政策相关多媒体文件存储桶",
        "purpose": "存储政策解读图表、宣传视频、培训音频等多媒体文件",
        "versioning": false,
        "lifecycle_policy": {
          "enabled": true,
          "rules": [
            {
              "id": "cleanup_temp_media",
              "status": "Enabled",
              "expiration": {
                "days": 90
              },
              "filter": {
                "prefix": "temp/"
              }
            }
          ]
        },
        "cors_config": {
          "allowed_origins": ["*"],
          "allowed_methods": ["GET", "POST", "PUT"],
          "allowed_headers": ["*"],
          "expose_headers": ["ETag", "Content-Length"],
          "max_age_seconds": 86400
        },
        "example_objects": [
          "infographics/2025/01/税收政策解读图.png",
          "videos/2025/01/企业注册流程讲解.mp4",
          "audio/2025/01/政策咨询培训.wav",
          "temp/policy_presentation_preview.jpg"
        ]
      },
      "policy-qa-thumbnails": {
        "description": "政策文档缩略图存储桶",
        "purpose": "存储政策文档和媒体文件的缩略图预览",
        "versioning": false,
        "lifecycle_policy": {
          "enabled": true,
          "rules": [
            {
              "id": "cleanup_unused_thumbnails",
              "status": "Enabled",
              "expiration": {
                "days": 60
              }
            }
          ]
        },
        "cors_config": {
          "allowed_origins": ["*"],
          "allowed_methods": ["GET"],
          "allowed_headers": ["*"],
          "max_age_seconds": 86400
        },
        "example_objects": [
          "doc_thumbnails/tax_policy_001_thumb.jpg",
          "media_thumbnails/business_guide_video_thumb.jpg",
          "generated/policy_preview_123.png"
        ]
      },
      "policy-qa-knowledge-graph": {
        "description": "政策知识图谱数据存储桶",
        "purpose": "存储政策知识图谱的导出数据、政策关系图、实体映射快照和备份",
        "versioning": true,
        "lifecycle_policy": {
          "enabled": true,
          "rules": [
            {
              "id": "archive_old_snapshots",
              "status": "Enabled",
              "noncurrent_version_expiration": {
                "noncurrent_days": 90
              }
            }
          ]
        },
        "example_objects": [
          "snapshots/2025/01/11/policy_graph_snapshot.json",
          "exports/policy_relations_20250111.graphml",
          "backups/policy_entities_backup_20250111.json",
          "mappings/policy_category_mapping.json"
        ]
      },
      "policy-qa-reports": {
        "description": "政策分析报告存储桶",
        "purpose": "存储系统生成的政策分析报告、统计数据、智能洞察等",
        "versioning": true,
        "lifecycle_policy": {
          "enabled": true,
          "rules": [
            {
              "id": "retain_monthly_reports",
              "status": "Enabled",
              "noncurrent_version_expiration": {
                "noncurrent_days": 365
              }
            },
            {
              "id": "cleanup_temp_reports",
              "status": "Enabled",
              "expiration": {
                "days": 7
              },
              "filter": {
                "prefix": "temp/"
              }
            }
          ]
        },
        "example_objects": [
          "monthly_reports/2025/01/政策咨询统计报告.pdf",
          "analytics/user_behavior/咨询热点分析_20250111.xlsx",
          "insights/policy_trends/税收政策趋势分析.json",
          "temp/draft_report_in_progress.tmp"
        ]
      },
      "policy-qa-backups": {
        "description": "系统备份存储桶",
        "purpose": "存储数据库备份、配置备份、政策数据备份等系统数据",
        "versioning": true,
        "lifecycle_policy": {
          "enabled": true,
          "rules": [
            {
              "id": "retain_daily_backups",
              "status": "Enabled",
              "noncurrent_version_expiration": {
                "noncurrent_days": 30
              }
            },
            {
              "id": "cleanup_temp_backups",
              "status": "Enabled",
              "expiration": {
                "days": 7
              },
              "filter": {
                "prefix": "temp/"
              }
            }
          ]
        },
        "example_objects": [
          "database/postgresql/policy_qa_20250111.sql.gz",
          "database/elasticsearch/policy_indices_backup_20250111.tar.gz",
          "config/system_config_backup_20250111.json",
          "policies/policy_data_backup_20250111.json",
          "temp/partial_backup_in_progress.tmp"
        ]
      },
      "policy-qa-logs": {
        "description": "系统日志文件存储桶",
        "purpose": "存储应用日志、用户咨询日志、审计日志等",
        "versioning": false,
        "lifecycle_policy": {
          "enabled": true,
          "rules": [
            {
              "id": "archive_old_logs",
              "status": "Enabled",
              "expiration": {
                "days": 180
              }
            }
          ]
        },
        "example_objects": [
          "app_logs/2025/01/11/policy_qa.log",
          "consultation_logs/2025/01/11/user_queries.log",
          "audit_logs/2025/01/11/admin_actions.log",
          "performance_logs/2025/01/11/agent_performance.log"
        ]
      },
      "policy-qa-cache": {
        "description": "缓存文件存储桶",
        "purpose": "存储预处理的政策数据、向量缓存、模型缓存等",
        "versioning": false,
        "lifecycle_policy": {
          "enabled": true,
          "rules": [
            {
              "id": "cleanup_expired_cache",
              "status": "Enabled",
              "expiration": {
                "days": 30
              }
            }
          ]
        },
        "example_objects": [
          "vectors/policy_embeddings_cache.bin",
          "models/policy_classifier_cache.pkl",
          "processed/policy_chunks_20250111.json",
          "temp/processing_cache.tmp"
        ]
      }
    },
    "security_policies": {
      "public_read_policy": {
        "Version": "2012-10-17",
        "Statement": [
          {
            "Effect": "Allow",
            "Principal": {"AWS": "*"},
            "Action": ["s3:GetObject"],
            "Resource": ["arn:aws:s3:::bucket-name/*"],
            "Condition": {
              "StringEquals": {
                "s3:x-amz-server-side-encryption": "AES256"
              }
            }
          }
        ]
      },
      "authenticated_read_write_policy": {
        "Version": "2012-10-17",
        "Statement": [
          {
            "Effect": "Allow",
            "Principal": {"AWS": "arn:aws:iam::*:user/policy-qa-user"},
            "Action": [
              "s3:GetObject",
              "s3:PutObject",
              "s3:DeleteObject"
            ],
            "Resource": ["arn:aws:s3:::bucket-name/*"]
          }
        ]
      },
      "admin_full_access_policy": {
        "Version": "2012-10-17",
        "Statement": [
          {
            "Effect": "Allow",
            "Principal": {"AWS": "arn:aws:iam::*:user/policy-qa-admin"},
            "Action": ["s3:*"],
            "Resource": [
              "arn:aws:s3:::bucket-name",
              "arn:aws:s3:::bucket-name/*"
            ]
          }
        ]
      }
    },
    "user_definitions": {
      "policy-qa-app": {
        "description": "政策问答应用程序服务账户",
        "policies": [
          "readwrite"
        ],
        "permissions": {
          "documents": "read-write",
          "media": "read-write", 
          "thumbnails": "read-write",
          "knowledge-graph": "read-write",
          "reports": "read-write",
          "cache": "read-write",
          "backups": "read-only",
          "logs": "write-only"
        }
      },
      "policy-qa-backup": {
        "description": "政策数据备份服务账户",
        "policies": [
          "writeonly"
        ],
        "permissions": {
          "documents": "read-only",
          "media": "read-only",
          "knowledge-graph": "read-only",
          "reports": "read-only",
          "backups": "read-write",
          "logs": "read-only"
        }
      },
      "policy-qa-readonly": {
        "description": "只读访问账户（用于监控和分析）",
        "policies": [
          "readonly"
        ],
        "permissions": {
          "documents": "read-only",
          "media": "read-only",
          "thumbnails": "read-only",
          "knowledge-graph": "read-only",
          "reports": "read-only",
          "cache": "read-only"
        }
      }
    },
    "monitoring_config": {
      "metrics": {
        "enabled": true,
        "endpoint": "/minio/v2/metrics/cluster",
        "scrape_interval": "30s"
      },
      "alerts": [
        {
          "name": "PolicyDocumentStorageQuotaExceeded",
          "condition": "bucket_usage_percent > 90",
          "severity": "warning",
          "message": "政策文档存储桶使用率超过90%"
        },
        {
          "name": "PolicyQAMinIOServiceDown",
          "condition": "up == 0",
          "severity": "critical", 
          "message": "政策问答系统MinIO服务不可用"
        },
        {
          "name": "PolicyQAHighErrorRate",
          "condition": "error_rate > 5",
          "severity": "warning",
          "message": "政策问答系统MinIO错误率过高"
        },
        {
          "name": "PolicyDocumentUploadFailure",
          "condition": "upload_error_rate > 2",
          "severity": "warning",
          "message": "政策文档上传失败率过高"
        }
      ]
    },
    "performance_tuning": {
      "server_config": {
        "drives": 4,
        "sets": 1,
        "cache_size": "4GB",
        "cache_expiry": "72h",
        "compression": true,
        "encryption": false
      },
      "client_config": {
        "connection_timeout": 30,
        "max_idle_conns": 10,
        "max_idle_conns_per_host": 5,
        "idle_conn_timeout": 90,
        "response_header_timeout": 30
      }
    },
    "backup_strategy": {
      "replication": {
        "enabled": false,
        "target_endpoint": "backup-policy-minio:9000",
        "sync_interval": "1h"
      },
      "snapshots": {
        "enabled": true,
        "schedule": "0 2 * * *",
        "retention_days": 30
      },
      "disaster_recovery": {
        "backup_bucket": "policy-qa-dr-backups",
        "cross_region_replication": false,
        "recovery_time_objective": "4h",
        "recovery_point_objective": "1h"
      }
    },
    "policy_specific_config": {
      "dynamic_classification": {
        "enabled": true,
        "classification_source": "database",
        "auto_classification": true,
        "ml_classification": true,
        "fallback_category": "uncategorized"
      },
      "category_structure": {
        "type": "hierarchical",
        "max_depth": 4,
        "path_separator": "/",
        "storage_pattern": "policies/{level1}/{level2}/{level3}/{level4}/",
        "metadata_indexing": true
      },
      "default_categories": {
        "tax_policies": {
          "prefix": "policies/tax/",
          "retention_years": 10,
          "importance_level": "high",
          "subcategories": ["income_tax", "corporate_tax", "vat", "customs"]
        },
        "business_regulations": {
          "prefix": "policies/business/", 
          "retention_years": 7,
          "importance_level": "high",
          "subcategories": ["registration", "licensing", "compliance", "industry_specific"]
        },
        "labor_laws": {
          "prefix": "policies/labor/",
          "retention_years": 10,
          "importance_level": "high",
          "subcategories": ["employment", "workplace_safety", "benefits", "disputes"]
        },
        "social_security": {
          "prefix": "policies/social/",
          "retention_years": 10,
          "importance_level": "medium",
          "subcategories": ["pension", "healthcare", "unemployment", "disability"]
        },
        "draft_policies": {
          "prefix": "policies/drafts/",
          "retention_days": 30,
          "importance_level": "low",
          "subcategories": ["under_review", "public_consultation", "archived"]
        }
      },
      "content_validation": {
        "allowed_formats": ["pdf", "docx", "txt", "html", "xml"],
        "max_file_size": "50MB",
        "virus_scan": true,
        "content_classification": true
      },
      "search_optimization": {
        "metadata_extraction": true,
        "ocr_processing": true,
        "semantic_indexing": true,
        "multilingual_support": true
      }
    }
  }
}